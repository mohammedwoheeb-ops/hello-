.upPaperCoil2_bg { position: absolute; bottom: 0px; width: 100%; height: 6px; background-image: url("icon/upCoil2_bg.png"); background-repeat: repeat-x; transform-origin: 0px center; transform: translate3d(0px, 0px, 0px) scale(1); }

.downPaperCoil2_bg { position: absolute; top: 0px; width: 100%; height: 6px; background-image: url("icon/downCoil2_bg.png"); background-repeat: repeat-x; transform-origin: 0px center; transform: translate3d(0px, 0px, 0px) scale(1); }


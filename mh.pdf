.calendar_form_phone .item .time { margin-top: 10px; margin-left: 100px; line-height: 16px; color: rgb(102, 102, 102); font-size: 13px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }

.calendar_form_phone .item .image { width: 80px; height: 100px; position: absolute; left: 20px; top: 10px; background-size: contain; background-repeat: no-repeat; background-position: center center; }

.calendar_form_phone .tips { margin-top: 24px; margin-bottom: 24px; color: rgb(153, 153, 153); font-size: 12px; text-align: center; }

.calendar_form_phone .item .tip { margin-top: 8px; color: rgb(102, 102, 102); background: rgb(244, 245, 247); font-size: 10px; width: 60px; height: 18px; line-height: 18px; vertical-align: middle; text-align: center; margin-left: 100px; }

.calendar_form_phone .search { height: 40px; width: 100%; position: relative; margin-top: 17px; }

.calendar_form_phone .searchBar { width: 247px; height: 36px; position: absolute; left: 16px; }

.calendar_form_phone .searchInput { border: 1px solid rgb(221, 221, 221); padding: 10px; width: 227px; height: 16px; font-size: 13px; vertical-align: middle; text-align: left; position: absolute; left: 0px; top: 0px; }

.calendar_form_phone .searchButton { width: 20px; height: 20px; position: absolute; right: 10px; top: 5px; }

.calendar_form_phone .searchCancleButton { width: 20px; height: 20px; position: absolute; right: 10px; top: 5px; }

.calendar_form_phone .dateButton { width: 118px; height: 36px; line-height: 36px; vertical-align: middle; text-align: center; position: absolute; right: 19px; background: rgb(54, 54, 54); color: rgb(255, 255, 255); font-size: 13px; padding-left: 20px; }

.calendar_form_phone .dateButton img { width: 16px; height: 16px; position: absolute; left: 20px; top: 10px; }

.calendar_form_phone .calendar_empty { width: 100%; height: auto; position: relative; margin-top: 181px; display: none; }

.calendar_form_phone .calendar_empty img { height: 130px; position: absolute; left: 50%; top: 0px; transform: translateX(-50%); }

.calendar_form_phone .calendar_empty p { text-align: center; color: rgb(102, 102, 102); font-size: 14px; top: 141px; position: relative; }

.card-book { position: absolute; width: 100%; height: 100%; top: 0px; left: 0px; z-index: 2; perspective: 1200px; perspective-origin: center center; transform-style: preserve-3d; clip-path: inset(-100% 0px); }

.card-book .card-side { position: absolute; z-index: 3; will-change: transform; }

.card-book .card-pages { position: absolute; will-change: transform; }

.catalog_simple_bar { position: absolute; height: 38px; top: 5px; left: 0px; right: 0px; margin: auto; border-radius: 3px; z-index: 1000; background: rgb(246, 246, 246); box-shadow: rgba(40, 40, 40, 0.5) 0px 0px 5px; }

.catalog_simple_bar .button:hover { opacity: 0.8; }

.catalog_simple_bar .button { position: absolute; cursor: pointer; top: 0px; width: 38px; height: 38px; }

.catalog_simple_bar .button div { margin-left: 1px; margin-top: 1px; width: 35px; height: 35px; }

.catalog_simple_bar .page_num { position: absolute; font-size: 16px; color: rgb(186, 186, 186); height: 38px; line-height: 38px; vertical-align: middle; text-align: center; font-family: arial, tahoma, sans-serif; }

.catalog_logo { position: absolute; cursor: pointer; z-index: 95; }

.catalogLeftShadow { position: absolute; top: 0px; right: 0px; height: 100%; z-index: 5; pointer-events: none; transform: translate3d(0px, 0px, 0px); background-image: -webkit-linear-gradient(right, rgba(60, 60, 60, 0.4) 0px, rgba(50, 50, 50, 0.1) 54%, rgba(200, 200, 200, 0) 100%); }

.catalogRightShadow { position: absolute; top: 0px; left: 0px; height: 100%; z-index: 5; pointer-events: none; transform: translate3d(0px, 0px, 0px); background-image: -webkit-linear-gradient(left, rgba(53, 53, 53, 0.5) 0px, rgba(53, 53, 53, 0.2) 40%, rgba(53, 53, 53, 0.1) 60%, rgba(200, 200, 200, 0) 100%); }

.catalogUpShadow { position: absolute; left: 0px; bottom: 0px; width: 100%; z-index: 5; pointer-events: none; transform: translate3d(0px, 0px, 0px); background-image: -webkit-linear-gradient(bottom, rgba(60, 60, 60, 0.4) 0px, rgba(50, 50, 50, 0.1) 54%, rgba(200, 200, 200, 0) 100%); }

.catalogDownShadow { position: absolute; left: 0px; top: 0px; width: 100%; z-index: 5; pointer-events: none; transform: translate3d(0px, 0px, 0px); background-image: -webkit-linear-gradient(top, rgba(53, 53, 53, 0.5) 0px, rgba(53, 53, 53, 0.2) 40%, rgba(53, 53, 53, 0.1) 60%, rgba(200, 200, 200, 0) 100%); }

.leftCoverShadow { position: absolute; top: 0px; right: 0px; height: 100%; width: 4px; background-image: -webkit-gradient(linear, 0% 0, 100% 0, from(rgba(200, 200, 200, 0)), to(rgb(200, 200, 200))); }

.rightCoverShadow { position: absolute; top: 0px; left: 0px; height: 100%; width: 4px; background-image: -webkit-gradient(linear, 0% 0, 100% 0, from(rgb(200, 200, 200)), to(rgba(200, 200, 200, 0))); }

.chatbot-drag { position: absolute; top: 0px; left: 0px; width: 90%; height: 50px; background: transparent; z-index: 1; pointer-events: auto; cursor: pointer; }

.chatbot-frame { box-sizing: border-box; width: 100%; height: 100%; border-radius: 12px; background-color: rgb(255, 255, 255); border: 1px solid rgba(0, 0, 0, 0.1); box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 20px 0px; position: absolute; z-index: 0; }

.chatbot-btn { display: flex; align-items: center; justify-content: center; border-radius: 50%; box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 20px 0px; cursor: pointer; }

.chatbot-btn-beckon { font-family: Calibri, Helvetica, sans-serif; font-size: 16px; color: rgb(51, 51, 51); font-weight: 400; }

.clickToRead { position: absolute; top: 50%; left: 50%; width: 120px; height: auto; margin-left: -70px; margin-top: -20px; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.7); cursor: pointer; padding: 10px; border-radius: 5px; text-align: center; font-size: 13px; line-height: 20px; z-index: 5000; transition: opacity 0.25s 0.5s, background-color 0.25s; touch-action: pan-y; user-select: none; -webkit-user-drag: none; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); font-weight: 500; }

.clickToRead:hover { background-color: rgba(0, 0, 0, 0.8); }

.clip[style] { opacity: 0; }

.active .clip:not([style]) { opacity: 0; animation: 0.1s ease 1s 1 normal both running fadeIn; }

.active .clip[style] { will-change: transform; animation: 1s ease 0s 1 normal both running noTransform; }

@keyframes noTransform { 
  100% { opacity: 1; transform: translate3d(0px, 0px, 0px) rotate(0deg); }
}

@keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.leftPaperCoil2_bg { position: absolute; right: 0px; width: 6px; height: 100%; background-image: url("icon/leftCoil2_bg.png"); background-repeat: repeat-y; transform-origin: 0px center; transform: translate3d(0px, 0px, 0px) scale(1); }


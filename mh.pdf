.upPaperCoil2 { position: absolute; inset: auto 0px 0px; width: 180px; height: 41px; background-image: url("icon/upCoil2.png"); background-repeat: repeat-x; transform-origin: 0px center; transform: translate3d(0px, 0px, 0px) scale(1); }

.downPaperCoil2 { position: absolute; inset: 0px 0px auto; width: 180px; height: 41px; background-image: url("icon/downCoil2.png"); background-repeat: repeat-x; transform-origin: 0px center; transform: translate3d(0px, 0px, 0px) scale(1); }

.leftPaperCoil_bg { position: absolute; right: 0px; width: 3px; height: 100%; background-image: url("icon/leftCoil1_bg.png"); background-repeat: repeat-y; }

.rightPaperCoil_bg { position: absolute; left: 0px; width: 3px; height: 100%; background-image: url("icon/rightCoil1_bg.png"); background-repeat: repeat-y; }

.upPaperCoil_bg { position: absolute; bottom: 0px; width: 100%; height: 3px; background-image: url("icon/upCoil1_bg.png"); background-repeat: repeat-x; }

.downPaperCoil_bg { position: absolute; top: 0px; width: 100%; height: 3px; background-image: url("icon/downCoil1_bg.png"); background-repeat: repeat-x; }

.leftPaperCoil { position: absolute; right: 0px; width: 41px; height: 100%; top: 0px; bottom: 0px; margin: auto; background-image: url("icon/leftCoil1.png"); background-repeat: repeat-y; }

.rightPaperCoil { position: absolute; left: 0px; width: 41px; height: 100%; top: 0px; bottom: 0px; margin: auto; background-image: url("icon/rightCoil1.png"); background-repeat: repeat-y; }

.upPaperCoil { position: absolute; bottom: 0px; left: 0px; right: 0px; margin: auto; height: 41px; width: 100%; background-image: url("icon/upCoil1.png"); background-repeat: repeat-x; }

.downPaperCoil { position: absolute; top: 0px; left: 0px; right: 0px; margin: auto; height: 41px; width: 100%; background-image: url("icon/downCoil1.png"); background-repeat: repeat-x; }

#createButton a { box-sizing: border-box; display: inline-flex; height: 32px; padding: 4px 10px; justify-content: center; align-items: center; gap: 4px; flex-shrink: 0; border-radius: 4px; background: rgb(0, 118, 254); color: rgb(255, 255, 255); font-family: "Microsoft YaHei"; font-size: 13px; font-style: normal; font-weight: 400; line-height: 16px; cursor: pointer; }

#createButton a:hover { text-decoration: none; }

#createButton img { width: 16px; height: 16px; }

.dockMenu { text-align: center; z-index: 300; display: block; overflow: visible; position: absolute; white-space: nowrap; -webkit-box-reflect: below 1px -webkit-gradient(linear, 0% 0%, 0% 100%, from(transparent), color-stop(0.85, transparent), to(rgba(255, 255, 255, 0.3))); }

.dockMenuContent { padding: 0px; list-style: none; text-align: center; display: inline-block; white-space: nowrap; }

.dockMenuItem { display: inline-block; vertical-align: bottom; position: relative; overflow: visible; text-align: center; cursor: pointer; }

.dockMenuItemContent { position: absolute; bottom: 1px; background: rgb(255, 255, 255); }

.dockMenuItemShadow { box-shadow: rgba(40, 40, 40, 0.5) 0px 0px 5px; }

.dockMenuItemCaption { line-height: 1.3em; text-align: center; width: auto; overflow: visible; font-weight: bold; color: rgb(255, 255, 255); font-size: 80%; padding: 4px 12px; opacity: 0.4; background-color: rgb(0, 0, 0); display: none; margin: 0px auto; top: 0px; border-radius: 10px; white-space: nowrap; }

.dockMenuItemCaptionAfter { display: none; height: 9px; line-height: 9px; left: 50%; opacity: 0.4; color: transparent; position: absolute; text-align: center; width: 16px; margin-left: -4px; margin-top: -2px; }

.menu { position: absolute; width: 100%; height: 170px; overflow: hidden; z-index: 5; bottom: -170px; }

.dockMenuContent { position: absolute; bottom: 30px; height: 140px; left: 25px; z-index: 1; }

.thumbnailItemContent { position: absolute; bottom: 0px; width: 100%; height: 30px; text-align: center; line-height: 30px; z-index: 2; display: inline-block; }

.thumbnailItem { position: relative; width: 40px; height: 20px; display: inline-block; margin-left: 4px; cursor: pointer; margin-top: 5px; }

.thumbnailRect { position: absolute; top: 7px; width: 40px; height: 5px; border-radius: 3px; background: rgb(80, 90, 96); }

.dockButton { width: 30px; height: 60px; margin-left: 10px; bottom: 1px; }

.dockButton div { width: 100%; height: 100%; background: rgb(51, 51, 51); opacity: 0.5; }

.dockButton img { inset: 0px; margin: auto; position: absolute; }

.download-password-panel { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; z-index: 10001; display: flex; align-items: center; flex-direction: column; justify-content: center; }

.download-password-mask { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.8); }

.download-password-container { z-index: 2; display: flex; align-items: center; flex-direction: column; justify-content: center; gap: 20px; }

.download-password-head { width: 100%; color: rgb(255, 255, 255); font-size: 24px; font-weight: 700; }

.download-password-subTitle { margin-top: 4px; font-size: 18px; }

.download-password-input { box-sizing: border-box; padding: 0px 10px; width: 288px; height: 40px; line-height: 40px; flex-shrink: 0; border-radius: 2px; border: 1px solid rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.15); color: rgb(255, 255, 255); font-size: 14px; font-weight: 700; }

.download-password-confirm { width: 288px; height: 40px; line-height: 40px; flex-shrink: 0; border-radius: 2px; background: rgb(128, 187, 255); text-align: center; color: rgb(255, 255, 255); font-size: 14px; font-weight: 700; cursor: not-allowed; }

.download-password-confirm-right { background: rgb(0, 118, 254); cursor: pointer; }

.flipbutton { position: relative; width: 100%; background: rgba(0, 0, 0, 0.6); cursor: pointer; }

.flipbutton:hover { background: rgba(0, 0, 0, 0.2); }

.flipbutton.upbutton { border-bottom: 1px solid rgb(255, 255, 255); height: 20%; }

.flipbutton.downbutton { height: 80%; }

.flipbutton.upbutton.left { border-radius: 5px 0px 0px; }

.flipbutton.downbutton.left { border-radius: 0px 0px 0px 5px; }

.flipbutton.upbutton.right { border-radius: 0px 5px 0px 0px; }

.flipbutton.downbutton.right { border-radius: 0px 0px 5px; }

.flipbutton img { position: absolute; top: 50%; left: 50%; margin-top: -10px; margin-left: -10px; }

.flip_button_left { position: absolute; cursor: pointer; right: auto; z-index: 10; }

.flip_button_right { position: absolute; cursor: pointer; left: auto; z-index: 10; }

.flip_button_first { position: absolute; cursor: pointer; right: auto; z-index: 10; opacity: 0.2; }

.flip_button_last { position: absolute; cursor: pointer; left: auto; opacity: 0.2; z-index: 10; }

.flipShotBar { position: absolute; }

.flipHTML5PhotoGallery-BG { position: absolute; inset: 0px; background-color: rgb(0, 0, 0); opacity: 0.5; }

.flipHTML5PhotoGallery { position: absolute; width: 320px; height: 320px; background-color: rgb(255, 255, 255); border: 8px solid rgb(255, 255, 255); cursor: pointer; }

.flipHTML5PhotoGallery-prevBtn, .flipHTML5PhotoGallery-nextBtn { position: absolute; width: 32px; height: 32px; top: 50%; margin-top: -16px; cursor: pointer; background-color: rgb(255, 255, 255); color: rgb(71, 71, 71); font-weight: bold; font-family: HelveticaNeue-Light, "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, "Lucida Grande", sans-serif; font-size: 24px; text-align: center; line-height: 30px; }

.flipHTML5PhotoGallery-thumb { position: absolute; width: 100%; height: 64px; background-color: rgba(0, 0, 0, 0.5); left: 0px; bottom: 0px; top: auto; }

.flipHTML5PhotoGallery-thumbView { position: absolute; overflow: hidden; height: 100%; }

.flipHTML5PhotoGallery-thumbList { position: absolute; height: 56px; top: 4px; left: 0px; }

.flipHTML5PhotoGallery-thumbTitle { position: absolute; background-color: rgb(0, 0, 0); font-family: HelveticaNeue-Light, "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, "Lucida Grande", sans-serif; color: rgb(255, 255, 255); height: 24px; line-height: 24px; font-size: 14px; font-weight: bold; padding: 0px 10px; }

.flipHTML5PhotoGallery-thumbTitle::after { content: ""; width: 0px; height: 0px; position: absolute; top: 100%; left: 6px; border-width: 11px 7px 0px; border-style: solid; border-color: rgb(0, 0, 0) transparent; }

.flipHTML5PhotoThumb, .flipHTML5PhotoThumbBG { transition: 0.6s; }

.flipHTML5VideoGallery-BG { position: absolute; inset: 0px; background-color: rgb(0, 0, 0); opacity: 0.5; }

.flipHTML5VideoGallery { position: absolute; width: 866px; height: 422px; left: 50%; margin-left: -433px; top: 50%; margin-top: -211px; border: 4px solid rgba(252, 251, 249, 0.5); border-radius: 4px; }

.flipHTML5VideoGallery-videoDiv { position: absolute; width: 504px; height: 370px; left: 17px; top: 6px; background-color: rgb(0, 0, 0); }

.flipHTML5VideoGallery-videoListDiv { position: absolute; width: 320px; height: 370px; left: auto; right: 17px; top: 6px; background-color: rgb(255, 255, 255); box-shadow: rgb(73, 73, 73) 0px 0px 1px; }

.flipHTML5VideoGallery-eachVideo { background: -webkit-linear-gradient(top, rgb(240, 240, 240), rgb(214, 214, 214)) rgb(211, 205, 205); box-shadow: rgb(0, 0, 0) 0px 0px 1px; }

.flipHTML5VideoGallery-eachVideo:hover { background: rgb(148, 148, 148); }

.flipHTML5VideoGallery-eachVideoDes { position: absolute; padding: 6px 8px 0px; width: 224px; height: 5em; overflow: hidden; font-family: HelveticaNeue-Light, "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, "Lucida Grande", sans-serif; font-size: 11px; color: rgb(26, 26, 26); font-weight: bold; }

.flipHTML5VideoGallery-videoTitle { position: absolute; left: 17px; bottom: 0px; width: 500px; height: 30px; font-family: HelveticaNeue-Light, "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, "Lucida Grande", sans-serif; font-size: 16px; color: rgb(255, 255, 255); vertical-align: middle; line-height: 30px; font-weight: bold; }

.flipHTML5VideoGallery-closeTitle, .flipHTML5PhotoGallery-closeTitle { position: absolute; background-color: rgb(0, 0, 0); color: rgb(255, 255, 255); font-weight: bold; font-size: 13px; font-family: HelveticaNeue-Light, "Helvetica Neue Light", "Helvetica Neue", Helvetica, Arial, "Lucida Grande", sans-serif; z-index: 8; height: 15px; line-height: 15px; padding: 0px 4px; }

@-webkit-keyframes handSwipeAnimate { 
  0% { opacity: 0; transform: rotateZ(30deg); }
  25% { opacity: 1; transform: rotateZ(30deg); }
  75% { opacity: 1; transform: rotateZ(-30deg); }
  100% { opacity: 0; transform: rotateZ(-30deg); }
}

@keyframes handSwipeAnimate { 
  0% { opacity: 0; transform: rotateZ(30deg); }
  25% { opacity: 1; transform: rotateZ(30deg); }
  75% { opacity: 1; transform: rotateZ(-30deg); }
  100% { opacity: 0; transform: rotateZ(-30deg); }
}

@-webkit-keyframes handSwipeAnimate_Right { 
  0% { opacity: 0; transform: rotateZ(-30deg); }
  25% { opacity: 1; transform: rotateZ(-30deg); }
  75% { opacity: 1; transform: rotateZ(30deg); }
  100% { opacity: 0; transform: rotateZ(30deg); }
}

@keyframes handSwipeAnimate_Right { 
  0% { opacity: 0; transform: rotateZ(-30deg); }
  25% { opacity: 1; transform: rotateZ(-30deg); }
  75% { opacity: 1; transform: rotateZ(30deg); }
  100% { opacity: 0; transform: rotateZ(30deg); }
}

.handSwipeHelp_Left { opacity: 0; transform: rotateZ(30deg); transform-origin: 50% 100%; animation: 1.5s ease-in-out 1s infinite normal none running handSwipeAnimate; }

.handSwipeHelp_Right { opacity: 0; transform: rotateZ(-30deg); transform-origin: 50% 100%; animation: 1.5s ease-in-out 1s infinite normal none running handSwipeAnimate_Right; }

.handSwipeHelp_Right > img { transform: rotateY(180deg); }

.handSwipeHelp_Top { opacity: 0; transform: rotateZ(30deg); transform-origin: 0px 50%; animation: 1.5s ease-in-out 1s infinite normal none running handSwipeAnimate; }

.handSwipeHelp_Top > img { transform: rotateZ(75deg); }

.hint { z-index: 101; position: absolute; display: none; left: 0px; top: 0px; cursor: default; font-family: Arial; font-size: 12px; color: rgb(237, 170, 29); border: 1px solid rgb(80, 80, 80); border-radius: 4px; padding: 5px; background-color: rgb(40, 40, 40); box-shadow: rgba(96, 96, 96, 0.5) 1px 1px 2px; }

.hint_active { cursor: pointer; }

.hint_active:hover { background-color: rgb(60, 60, 60); }

.hint_active:active { background-color: rgb(80, 80, 80); }

.hintBackground { background-color: rgb(206, 206, 206); color: rgb(252, 252, 252); border-color: rgb(252, 252, 252); border-radius: 3px; position: absolute; max-width: 120px; max-height: 30px; text-align: center; z-index: 101; padding: 5px; }

.invert-book { position: relative; z-index: 3; perspective: 1200px; perspective-origin: center center; transform-style: preserve-3d; clip-path: inset(-100% 0px); }

.invert-book .invert-side { position: absolute; top: 50%; left: 50%; transform-style: preserve-3d; transform-origin: center center; transform: translate(-50%, -50%) rotateY(0deg); z-index: 5; will-change: transform; backface-visibility: hidden; }

.invert-book .invert-side.side-current-y { transform: translate(-50%, -50%) rotateY(0deg); z-index: 6; pointer-events: auto; }

.invert-book .invert-side.side-prev-y { transform: translate(-50%, -50%) rotateY(-180deg); z-index: 5; pointer-events: none; }

.invert-book .invert-side.side-next-y { transform: translate(-50%, -50%) rotateY(180deg); z-index: 5; pointer-events: none; }

.invert-book .invert-side.side-current-x { transform: translate(-50%, -50%) rotateX(0deg); z-index: 6; pointer-events: auto; }

.invert-book .invert-side.side-prev-x { transform: translate(-50%, -50%) rotateX(180deg); z-index: 5; pointer-events: none; }

.invert-book .invert-side.side-next-x { transform: translate(-50%, -50%) rotateX(-180deg); z-index: 5; pointer-events: none; }

.invert-book .invert-side .invert-pages { backface-visibility: hidden; }

.jedatebox { min-width: 230px; height: auto; font-family: PingFangSC-Light, "PingFang SC", "Segoe UI", "Lucida Grande", NotoSansHans-Light, "Microsoft YaHei", å¾®è½¯é›…é»‘, STHeiti, "WenQuanYi Micro Hei", SimSun, sans-serif; font-size: 12px; cursor: default; margin: 0px; padding: 0px; overflow: hidden; position: relative; border-radius: 3px; float: left; }

.jedatebox * { margin: 0px; padding: 0px; list-style-type: none; box-sizing: border-box; font-style: normal; font-family: PingFangSC-Light, "PingFang SC", "Segoe UI", "Lucida Grande", NotoSansHans-Light, "Microsoft YaHei", å¾®è½¯é›…é»‘, STHeiti, "WenQuanYi Micro Hei", SimSun, sans-serif; }

.jedatebox ul, .jedatebox ol, .jedatebox li, .jedatebox dl { list-style-type: none; font-style: normal; font-weight: 300; }


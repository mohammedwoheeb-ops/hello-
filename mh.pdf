.annotation-action-btn-icon { display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; }

.annotation-text-note-input-dialog { box-sizing: border-box; padding: 20px; position: absolute; z-index: 3001; background: rgb(255, 255, 255); border-radius: 12px; box-shadow: rgba(29, 31, 33, 0.1) 0px 4px 28px 0px; border: 1px solid rgb(236, 236, 236); display: flex; flex-direction: column; gap: 12px; min-width: 300px; max-width: 400px; max-height: 300px; font-family: Calibri, Helvetica, Inter; }

.annotation-text-note-input-header { display: flex; align-items: center; justify-content: space-between; }


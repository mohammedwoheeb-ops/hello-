.language-panel { position: fixed; inset: 0px; z-index: 2000; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; padding: 32px; font-family: Calibri, Helvetica, Inter; background: rgba(0, 0, 0, 0.85); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.2s, visibility 0.2s; }

.language-panel-title { margin: 0px; padding-bottom: 40px; font-size: 20px; font-weight: 600; line-height: 1.2; color: rgb(255, 255, 255); text-align: center; flex-shrink: 0; width: 100%; box-sizing: border-box; }

.language-panel-close { box-sizing: border-box; position: absolute; right: 32px; top: 32px; display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; padding: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; background: rgba(255, 255, 255, 0.12); cursor: pointer; transition: background 0.2s; }

.language-panel-close img { width: 24px; height: 24px; display: block; }

.language-panel.rightToLeft .language-panel-close { right: auto; left: 32px; }

.language-panel.is-open { opacity: 1; visibility: visible; pointer-events: auto; }

.language-panel-body { display: flex; flex-direction: column; align-items: center; justify-content: center; width: max-content; max-width: 100%; max-height: 100%; min-height: 0px; box-sizing: border-box; overflow: hidden; }

.language-grid-wrapper { width: max-content; max-width: 100%; flex: 1 1 auto; min-height: 0px; overflow: hidden auto; touch-action: pan-y; }

.language-grid-wrapper::-webkit-scrollbar { width: 6px; }

.language-grid-wrapper::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.45); border-radius: 3px; }

.language-panel .language-grid { --language-item-width: 135px; --language-grid-gap: 32px; display: flex; flex-wrap: wrap; gap: var(--language-grid-gap); width: max-content; max-width: 803px; justify-content: flex-start; }

.language-panel .language-item { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 var(--language-item-width,135px); width: var(--language-item-width,135px); min-width: 0px; max-width: 100%; border: 3px solid transparent; border-radius: 8px; background: transparent; height: 52px; line-height: 52px; padding: 0px; font-size: 16px; color: rgb(255, 255, 255); cursor: pointer; font-weight: 500; transition: 0.2s; text-align: center; -webkit-tap-highlight-color: transparent; }

@media not all {
  .language-panel .language-item:hover { background: rgba(238, 238, 238, 0.08); }
}

.language-panel-body:not(.is-touch-scrolling) .language-item:active { background: rgba(238, 238, 238, 0.08); }

.language-panel .language-item.focus { border-color: rgb(0, 153, 255); }

@media (max-width: 768px) {
  .language-panel-title { font-size: 18px; }
  .language-panel .scrollBox { padding: 0px; }
  .language-panel .language-grid { display: flex; flex-wrap: wrap; gap: var(--language-grid-gap); width: max-content; max-width: 100%; padding: 0px 16px; box-sizing: border-box; justify-content: flex-start; }
  .language-grid-wrapper { width: 100%; max-width: 100%; }
}

@media not all {
  .language-panel .language-grid { max-width: 469px; }
}

@media (max-width: 480px) {
  .language-panel-close { box-sizing: border-box; position: absolute; top: 20px; right: 20px; width: 40px; height: 40px; }
  .language-panel.rightToLeft .language-panel-close { left: 20px; right: auto; }
  .language-panel { align-items: stretch; justify-content: flex-start; padding: 0px; }
  .language-panel-body { width: 100%; max-width: 100%; margin-top: 88px; flex: 1 1 auto; min-height: 0px; max-height: none; padding-bottom: max(24px,env(safe-area-inset-bottom,0px)); justify-content: flex-start; align-items: center; }
  .language-panel .language-grid { justify-content: center; }
}

.menuTitle { cursor: pointer; overflow: hidden; width: 100%; height: 50px; font-family: Arial, Tahoma; }

.menuTitleIcon { cursor: pointer; position: absolute; top: 10px; left: 20px; width: 32px; height: 32px; border-radius: 16px; }

.menuTitleIcon div { cursor: pointer; position: absolute; top: 6px; left: 6px; width: 20px; height: 20px; }

.menuTitleCaption { cursor: pointer; position: absolute; left: 60px; top: 18px; font-size: 14px; color: rgb(255, 255, 255); }

.menuTitleState { position: absolute; top: 15px; right: 20px; width: 24px; height: 24px; }

.flip-message-container { position: fixed; top: 20px; left: 0px; right: 0px; z-index: 9999; pointer-events: none; box-sizing: border-box; }

.flip-message + .flip-message { margin-top: 16px; }

.flip-message { position: relative; box-sizing: border-box; width: fit-content; max-width: calc(100% - 32px); margin-left: auto; margin-right: auto; padding: 11px 15px; border-radius: 4px; border: 1px solid rgb(233, 233, 235); display: flex; align-items: center; gap: 8px; background-color: rgb(244, 244, 245); color: rgb(144, 147, 153); pointer-events: all; opacity: 0; transform: translateY(-100%); transition: opacity 0.3s, transform 0.4s; font-size: 14px; line-height: 1; }

.flip-message.show { opacity: 1; transform: translateY(0px); }

.flip-message-content { flex: 1 1 auto; min-width: 0px; margin: 0px; padding: 0px; font-size: 14px; line-height: 1; overflow-wrap: break-word; text-align: justify; text-align-last: left; }

.flip-message-close { flex-shrink: 0; cursor: pointer; font-size: 16px; color: rgb(168, 171, 178); line-height: 1; }

.flip-message-close:hover { color: rgb(96, 98, 102); }

.flip-message.success { background-color: rgb(240, 249, 235); border-color: rgb(225, 243, 216); color: rgb(103, 194, 58); }

.flip-message.success .flip-message-content { color: rgb(103, 194, 58); }

.flip-message.info { background-color: rgb(244, 244, 245); border-color: rgb(233, 233, 235); color: rgb(144, 147, 153); }

.flip-message.info .flip-message-content { color: rgb(144, 147, 153); }

.flip-message.warning { background-color: rgb(253, 246, 236); border-color: rgb(250, 236, 216); color: rgb(230, 162, 60); }

.flip-message.warning .flip-message-content { color: rgb(230, 162, 60); }

.flip-message.error { background-color: rgb(254, 240, 240); border-color: rgb(253, 226, 226); color: rgb(245, 108, 108); }

.flip-message.error .flip-message-content { color: rgb(245, 108, 108); }

.message_form { width: 310px; height: 120px; padding: 20px; border-radius: 5px; color: rgb(255, 255, 255); background: rgb(0, 0, 0); vertical-align: middle; }

.message_form .content { width: 310px; height: 120px; position: absolute; top: 20px; left: 20px; }

.message_form .content .title { line-height: 30px; font-size: 18px; text-align: left; }

.message_form .content .btn { cursor: pointer; font-size: 14px; border-radius: 2px; width: 66px; height: 26px; line-height: 26px; vertical-align: middle; text-align: center; position: absolute; bottom: 0px; right: 0px; background-color: rgba(255, 255, 255, 0.2); }

.message_form .content .btnCancle { right: 80px; }

.miniFullscreen { z-index: 1000; height: 30px; line-height: 30px; background: rgb(0, 0, 0); border-radius: 18px; left: 50%; transform: translate(-50%, 0px); position: absolute; color: rgb(255, 255, 255); vertical-align: middle; text-align: center; cursor: pointer; font-family: Tahoma, "sans-serif", Arial; font-size: 12px; padding: 3px 20px; opacity: 0.7; white-space: nowrap; }

.miniFullscreen:hover { opacity: 0.7; }

.miniLogo { width: 100px; right: 0px; bottom: 0px; opacity: 0.5; position: absolute; cursor: pointer; z-index: 100; }

.miniLogo:hover { opacity: 1; }

.miniTitle { z-index: 1000; height: 30px; line-height: 30px; background: rgba(51, 51, 51, 0.5); border-radius: 5px; left: 50%; top: 0px; bottom: 0px; transform: translate(-50%, 0px); position: absolute; color: rgb(255, 255, 255); vertical-align: middle; text-align: center; cursor: pointer; font-family: Tahoma, "sans-serif", Arial; font-size: 12px; padding: 3px 7px; margin: auto; white-space: nowrap; }

.neat_menu .slider { position: absolute; cursor: pointer; left: 50%; top: 50%; transform: translate(-50%, -50%); background: rgba(255, 255, 255, 0.4); border-radius: 4px; border: 1px solid rgba(0, 0, 0, 0.2); }

.neat_menu .sliderEnter { position: absolute; left: 0px; top: 0px; width: 0px; height: 6px; background: rgb(255, 255, 255); border-radius: 4px; }

.neat_menu .pointer { width: 30px; height: 30px; position: absolute; margin-left: -15px; left: 0px; top: -14px; }

.neat_menu .pointer div { border: 1px solid rgba(0, 0, 0, 0.2); background: rgb(255, 255, 255); cursor: pointer; position: absolute; left: 7px; top: 7px; width: 16px; height: 16px; border-radius: 50%; }

.neat_menu .thumbnail { width: 74px; height: 120px; position: absolute; margin-left: -37px; left: 0px; top: -140px; z-index: 300; background-color: rgb(255, 255, 255); background-repeat: no-repeat; background-position: center center; background-size: contain; display: none; border: 1px solid rgba(0, 0, 0, 0.7); }

.neat_menu .thumbnail span { width: 36px; height: 20px; line-height: 20px; vertical-align: middle; text-align: center; color: rgb(255, 255, 255); position: absolute; right: 5px; top: 5px; border-radius: 5px; background: rgba(0, 0, 0, 0.7); }

.sideContent { position: absolute; transform-origin: 0px center; background-color: white; }

.boxShadow { box-shadow: rgba(40, 40, 40, 0.2) 0px 0px 3px; }

.sideBackground { position: inherit; top: 0px; left: 0px; width: 320px; height: 460px; }

.kong { position: absolute; top: 0px; left: 0px; z-index: 1; }

.pageMask { position: inherit; top: 0px; left: 0px; width: 320px; height: 860px; overflow: hidden; }

.loadingOuter { position: absolute; margin: auto; inset: 0px; width: 100%; height: 100%; z-index: 5; background-repeat: no-repeat; background-position: center center; }

.loadingImage { position: absolute; margin: auto; inset: 0px; }

.edgeShadow { background-image: -webkit-gradient(linear, 0% 0, 100% 0, from(rgba(50, 50, 50, 0.5)), to(rgba(230, 230, 230, 0))); width: 50%; height: 100%; z-index: 1000; position: absolute; left: -50%; top: -50%; pointer-events: none; transform: translateX(50%) rotate(30deg); transform-origin: 0px 50%; }

.grayShadow { width: 100%; height: 100%; position: absolute; z-index: 10000; overflow: hidden; pointer-events: none; }

.hardCover { position: absolute; z-index: -1; }

.hardSide { position: absolute; }

.pageSide { overflow: hidden; position: absolute; }

.passwardPannel { position: absolute; z-index: 991; background: rgb(255, 255, 255); width: 90%; inset: 0px; height: 330px; margin: auto; max-width: 400px; border-radius: 5px; line-height: 50px; vertical-align: middle; text-align: center; font-family: "Arial Black"; font-size: 20px; }

.passwardPannel .icon div { width: 100%; height: 100%; }

.passwardPannel .icon { width: 100px; height: 100px; left: 50%; position: relative; margin: 10px 0px 10px -50px; }

.passwardPannel input { width: 82%; height: 50px; border-radius: 5px; margin-bottom: 10px; border-width: 0px; background: rgb(235, 235, 235); padding: 0px 3%; color: rgb(159, 160, 163); }

.passwardPannel p { margin: 0px 6% 10px; width: 88%; height: 50px; border-radius: 5px; background: rgb(24, 155, 237); color: rgb(255, 255, 255); cursor: pointer; }

.passwardPannel .cancleIn { background: rgb(244, 241, 241); border: 1px solid rgb(229, 225, 225); color: rgb(182, 181, 181); }

.passwardPannel .passwardResult { color: rgb(255, 0, 0); position: absolute; bottom: -8px; margin-left: 6%; left: 0px; font-size: 10px; }

.passwardPannel-background { position: absolute; z-index: 990; background: rgba(0, 0, 0, 0.5); width: 100%; height: 100%; }

.passwardPannel .passwardInfo { line-height: 20px; background: rgba(0, 0, 0, 0.5); text-align: left; position: absolute; border-radius: 5px; color: rgb(255, 255, 255); padding: 12px; font-weight: normal; right: 0px; bottom: 345px; max-width: 400px; font-size: 12px; font-family: Arial; height: auto; }

.passwardPannel .top { position: absolute; width: 0px; height: 0px; line-height: 0; border-width: 10px 7px; border-style: solid; border-color: rgba(0, 0, 0, 0.5) transparent transparent; bottom: -20px; right: 18px; }

.passwardPannel .info-icon { position: absolute; right: 15px; top: 10px; width: 20px; height: 20px; }

.passwardPannel .info-icon .svg { position: absolute; width: 20px; height: 20px; left: 0px; top: 0px; }

.passwardPannel .passwardInfo a { text-decoration: underline; }

.passwardPannel .promptBox { background: rgb(63, 63, 63); text-align: left; position: absolute; border-radius: 5px; color: rgb(255, 255, 255); padding: 3%; font-weight: normal; right: 6%; bottom: 225px; max-width: 82%; font-size: 12px; font-family: Arial; height: auto; z-index: 2; }

.passwardPannel .prompt { line-height: normal; color: rgb(255, 255, 255); font-size: 12px; z-index: 5; border-radius: 5px; max-height: 310px; overflow-y: auto; }

.passwardPannel .prompt u { color: rgb(255, 255, 255); text-decoration: underline; }

.passwardPannel .promptBox .arrow { border-top: 10px solid rgb(63, 63, 63); }

.pctel_form { font-family: Arial; position: absolute; margin: auto; vertical-align: middle; width: 200px; }

.pctel_form .stage { overflow: hidden; width: 100%; position: relative; }

.pctel_form .swiper { width: 100%; position: relative; left: 0px; top: 0px; box-sizing: border-box; }

.pctel_form .swiper .item { position: relative; font-size: 14px; min-height: 40px; display: table; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }

.pctel_form .text_bubble_content { border-radius: 0px; }

.pctel_form .swiper .item .number { width: 72px; text-align: center; display: table-cell; padding: 4px; vertical-align: middle; }

.pctel_form .swiper .item a { display: table-cell; padding: 4px; width: 112px; text-align: center; vertical-align: middle; }

.pctel_form .stageArrow { position: absolute; font-size: 0px; z-index: 1; overflow: hidden; bottom: -3px; }

.phoneBookmark .scrollBox { width: 100%; height: 100%; overflow: hidden auto; }

.phoneBookmark .item { position: relative; width: 100%; height: 100px; line-height: 100px; vertical-align: middle; font-size: 15px; color: rgb(170, 170, 170); cursor: pointer; }

.phoneBookmark .item span { margin: 0px 10px; float: left; display: inline-block; width: 20px; }

.phoneBookmark .item img { height: 76px; float: left; margin: 12px 0px; }

.phoneBookmark .item .close { position: absolute; cursor: pointer; top: 30px; right: 10px; width: 41px; height: 41px; background-position: -402px -429px; background-image: url("phoneIcon/phone_icon.png"); background-repeat: no-repeat; }

.phoneBookmark .item .close:hover { background-position: -462px -429px; }

.photogallery { position: absolute; display: none; z-index: 1001; left: 0px; top: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); text-align: center; vertical-align: middle; }

.photogallery .imgContainer { position: absolute; z-index: 1; overflow: hidden; cursor: pointer; border: 8px solid rgb(255, 255, 255); background: rgb(255, 255, 255); }

.photogallery .photoBG { position: absolute; z-index: 0; background: rgba(0, 0, 0, 0.5); inset: 0px; }

.photogallery .close { position: absolute; right: 0px; top: 0px; z-index: 1; cursor: pointer; }

.photogallery .leftBtn { position: absolute; left: -32px; z-index: 1; cursor: pointer; }

.photogallery .rightBtn { position: absolute; right: -32px; z-index: 1; cursor: pointer; }

.photogallery .imgContainer > img { position: absolute; cursor: pointer; }

.photogallery .thumbContainer { position: absolute; bottom: 0px; width: 100%; height: 60px; z-index: 1; }

.photogallery .thumbBG { position: absolute; z-index: 2; inset: 0px; background-color: rgba(0, 0, 0, 0.5); display: block; transition: 0.3s; }

.photogallery .thumbBox { position: absolute; cursor: pointer; width: 50px; height: 46px; top: 4px; border: 2px solid rgb(255, 255, 255); transition: 0.3s ease-out; }

.photogallery .thumbBox img { position: absolute; cursor: pointer; }

.photogallery .thumbBox:hover { border: 2px solid rgb(0, 255, 0); }

.photogallery .thumbBox.focus { border: 2px solid rgb(255, 0, 0); }

.photogallery .thumbBox:hover .thumbBG { z-index: 0; }

.photogallery .thumbBox.focus .thumbBG { z-index: 0; }

.pictureList_win10 { display: flex; align-items: center; justify-content: space-between; width: 150px; height: 196px; position: absolute; left: 0px; }

.pictureList_win10 .thumbnail .page { width: 100%; height: 20px; line-height: 20px; }

.pictureList_win10 .thumbnail img { vertical-align: middle; width: 100%; }

.pictureList_win10 .btn { position: absolute; top: 0px; bottom: 0px; width: 18px; height: 18px; cursor: pointer; margin: auto; z-index: 3; }

.pictureList_win10 .leftBtn { left: 0px; }

.pictureList_win10 .rightBtn { right: 0px; }

.pictureList_win10 { left: 0px; text-align: center; vertical-align: middle; }

.pictureList_win10 .thumbnail { width: 100%; position: relative; display: inline-block; left: 0px; top: 0px; text-align: center; vertical-align: middle; }

.pictureList_win10::after { content: ""; display: inline-block; height: 100%; vertical-align: middle; }

.printBar { bottom: 0px; left: 0px; right: 0px; position: absolute; background-color: rgb(0, 0, 0); opacity: 0.6; height: 120px; z-index: 100; }

.printBG p { padding: 18px 0px 0px; }

.printBG { position: absolute; bottom: 1px; left: 0px; right: 0px; height: 105px; overflow: hidden; opacity: 0.9; border-radius: 5px; z-index: 102; }

.printBack { position: absolute; bottom: 1px; left: 0px; right: 0px; height: 105px; overflow: hidden; opacity: 0.9; background-color: rgb(153, 153, 153); border-radius: 5px; z-index: 101; }

.printBox { position: absolute; }

.printBox input[type="radio"] { background-color: rgb(187, 176, 0); }

.printBox label { display: inline-block; font-family: Arial; font-size: 10px; }

.search_loader { box-sizing: border-box; display: flex; flex-direction: column; flex: 1 0 25%; max-width: 25%; height: 200px; align-items: center; justify-content: center; margin: auto; inset: 0px; position: absolute; }

.phoneSharePanel { width: 100%; height: 100%; overflow: hidden auto; }

.phoneSharePanel .item { padding: 10px; border-bottom: 1px solid rgb(71, 71, 71); vertical-align: middle; color: rgb(255, 255, 255); line-height: 50px; height: 50px; font-weight: bold; }

.phoneSharePanel .item .logo { width: 50px; height: 50px; display: inline-block; float: left; }

.phoneSharePanel .item .logo div { width: 50px; height: 50px; }

.phoneSharePanel .item span { margin-left: 20px; float: left; }

.sharePanel { display: flex; flex-wrap: wrap; gap: 10px; }

.sharePanel .share-item { display: inline-block; width: 42px; height: 42px; cursor: pointer; }

.sharePanel .share-item:hover { opacity: 0.8; }

.sharePanel .item { width: 30px; height: 30px; margin: 10px 0px 10px 10px; display: inline-block; }

.sharePanel .item .logo { width: 30px; height: auto; }

.slideToolbar { z-index: 5; position: absolute; top: 0px; left: 50%; margin: 0px auto; padding: 5px; border-radius: 0px 0px 5px 5px; opacity: 0.7; }

.slideToolbar:hover { opacity: 1; }

.slideToolbar img { width: 32px; margin: 0px 5px; cursor: pointer; }

.slideBar { z-index: 5; position: absolute; cursor: pointer; width: 50px; height: 50px; top: 50%; opacity: 0.7; margin-top: -25px; }

.SlideBook { position: absolute; width: 100%; height: 100%; top: 0px; left: 0px; z-index: 2; }

.SlideBook .slide_side { width: 100%; height: 100%; position: absolute; }

.SlideBook .slide_pages { position: absolute; }

.text_bubble { position: absolute; z-index: 10003; display: none; }

.text_bubble_content { position: relative; border-radius: 3px; }

.text_bubble_text { font-family: Tahoma, "sans-serif", Arial; font-size: 12px; font-weight: 100; }

.text_bubble_arrow { position: absolute; font-size: 0px; z-index: 1; overflow: hidden; }

.tipsBox { padding: 10px 6px; background-color: rgb(51, 51, 51); opacity: 0.5; display: none; width: 190px; left: 0px; right: 0px; top: 100px; margin: auto; z-index: 110; position: absolute; font-size: 15px; color: rgb(240, 240, 240); vertical-align: middle; text-align: center; }

.tipsBoxShadow { box-shadow: rgba(40, 40, 40, 0.6) 0px 0px 15px; }

.tipsBoxRadius { border-radius: 3px; }

.toolbar_head { position: absolute; width: 100px; height: 82px; top: 70px; left: 0px; z-index: 1000; }

.toolbar_head .btn { cursor: pointer; width: 48px; display: inline-block; margin-left: 20px; position: relative; padding-left: 40px; font-size: 14px; top: 0px; height: 32px; line-height: 32px; vertical-align: middle; background: rgb(255, 255, 255); }

.toolbar_head .btn img { position: absolute; width: 15px; height: 15px; top: 8px; left: 20px; }

.toolbar_head .btn:hover { opacity: 0.8; }

#ezmob-wrapper { position: absolute; z-index: -2; }

.topRightBar { z-index: 99; position: absolute; right: 12px; height: 100%; display: flex; align-items: center; gap: 8px; }

.topRightButton { z-index: 99; position: absolute; top: 12px; right: 12px; display: flex; align-items: center; gap: 8px; }

.topRightBar .topRightButton { z-index: 99; display: flex; align-items: center; gap: 8px; position: initial; top: initial; right: initial; }

* { box-sizing: content-box; }

::before, ::after { box-sizing: content-box; }

select { box-sizing: border-box; }

html { scroll-behavior: smooth; }

html { width: 100%; height: 100%; left: 0px; top: 0px; margin: 0px; padding: 0px; position: fixed; }

body { position: fixed; width: 100%; height: 100%; margin: 0px; transform: translate(0px); border: 0px; left: 0px; top: 0px; user-select: none; overflow: hidden !important; padding: 0px !important; }

img { -webkit-user-drag: none; }

p { margin: 0px; padding: 0px; }

input { outline: none; }

textarea { outline: none; }

ul, ol, li { list-style-type: none; margin: 0px; padding: 0px; }

h1, h1, h2, h3, h4, h5, h6 { font-weight: normal; }

i, u { font-style: normal; text-decoration: none; }

a:hover { text-decoration: underline; }

a { text-decoration: none; color: inherit; }

.rtl { direction: rtl; }

.tmpContainer { position: fixed; width: 100%; height: 100%; bottom: 0px; top: 0px; left: 0px; display: block; z-index: -1; }

.bookContainer { position: absolute; width: 100%; height: 100%; z-index: 2; top: 0px; left: 0px; display: block; overflow: hidden; }

.hover_background:hover { background: rgba(0, 0, 0, 0.1); }

.bookmark_form .item:hover { background: rgba(0, 0, 0, 0.1); }

.tableofcontent_form .item .page { padding: 0px 15px; }

.fbToolBar .topRightButton { top: initial; right: 12px; height: 100%; }

.fbTopBar .topRightButton { top: initial; right: 12px; height: 100%; }

.share_form .codeButton { display: flex; }

.bookmark_form .inputForm > .colorSelection { background: conic-gradient(from 180deg, rgb(142, 94, 255) 0deg, rgb(255, 91, 253) 43.39deg, rgb(255, 97, 150) 90.03deg, rgb(255, 112, 112) 139.76deg, rgb(255, 219, 91) 179.18deg, rgb(114, 255, 125) 229.99deg, rgb(86, 255, 249) 284.39deg, rgb(88, 102, 255) 343.39deg, rgb(142, 94, 255) 360deg) !important; }

.bookmark_form .item .colorSelection { top: 7px; }

.volume-bar { vertical-align: middle; position: absolute; z-index: 999; }

.volume-reduce { cursor: pointer; position: absolute; }

.volume-add { cursor: pointer; position: absolute; }

.volume-pgress { position: absolute; border: 0px; }

.volume-pgress span { cursor: pointer; display: block; position: absolute; width: 12px; height: 12px; background: rgb(255, 255, 255); border-radius: 50%; }

.zoomControlBar { gap: 5px; height: 40px; position: absolute; z-index: 5; display: none; opacity: 0.3; transition: 0.2s ease-in-out; }

.zoomControlBar.catalog { width: 138px; }

.zoomControlBar:hover { opacity: 0.7; }

.zoomControlBar .button { padding: 0px 10px; width: 20px; height: 100%; flex: 1 1 0%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: none; margin: 0px; cursor: pointer; }

.zoomControlBar .button:hover { opacity: 0.8; }

.thumbnail_map { position: absolute; z-index: 202; display: none; border: 5px solid rgb(255, 255, 255); box-shadow: gray 0px 0px 5px; background-color: white; }

.map_img_left { top: 0px; left: 0px; height: 98px; position: absolute; border-left: 1px solid gray; border-top: 1px solid gray; border-bottom: 1px solid gray; }

.map_img_right { top: 0px; right: 0px; height: 98px; position: absolute; border-right: 1px solid gray; border-top: 1px solid gray; border-bottom: 1px solid gray; }

.map_img_up { top: 0px; left: 0px; height: 98px; position: absolute; border-left: 1px solid gray; border-top: 1px solid gray; border-right: 1px solid gray; }

.map_img_down { bottom: 0px; left: 0px; height: 98px; position: absolute; border-left: 1px solid gray; border-bottom: 1px solid gray; border-right: 1px solid gray; }

.map_cursor { position: absolute; border: 2px solid green; background-color: rgba(250, 240, 185, 0.5); }

.leftShadow { position: absolute; top: 0px; right: 0px; height: 100%; z-index: 5; pointer-events: none; background-repeat: repeat-y; background-size: 100%; }

.rightShadow { position: absolute; top: 0px; left: 0px; height: 100%; z-index: 5; pointer-events: none; background-repeat: repeat-y; background-size: 100%; }

.upShadow { position: absolute; left: 0px; bottom: 0px; width: 100%; z-index: 5; pointer-events: none; background-repeat: repeat-x; background-size: 100% 100%; }

.downShadow { position: absolute; left: 0px; top: 0px; width: 100%; z-index: 5; pointer-events: none; background-repeat: repeat-x; background-size: 100% 100%; }


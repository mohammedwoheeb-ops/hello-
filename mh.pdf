.cover_shadow.side .hard_left_body { position: absolute; left: 2.5%; top: 0px; width: 1.5%; height: 100%; background-image: -webkit-linear-gradient(left, rgba(40, 40, 20, 0) 0px, rgba(40, 40, 20, 0.4) 35%, rgba(40, 40, 20, 0) 100%); }


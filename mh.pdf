------MultipartBoundary--GWjsRTaKvsvTCebUH8Nf1s74nscp3HTgTUqhwby9RN----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://static.fliphtml5.com/resourceFiles/html5_templates/template/Popular/style/flipbook.min.css

@charset "utf-8";

.book { position: absolute; z-index: 2; cursor: default; }

.mask { cursor: default; position: absolute; right: 50%; left: auto; transform-origin: 100% 50%; overflow: hidden; backface-visibility: visible; }

.single-book-mask { cursor: default; position: absolute; right: 100%; left: auto; transform-origin: 100% 50%; overflow: hidden; backface-visibility: hidden; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.single-book-right-mask { cursor: default; position: absolute; right: 0px; left: auto; transform-origin: 100% 50%; overflow: hidden; backface-visibility: hidden; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.right-single-mask-side { cursor: default; position: absolute; left: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.left-single-mask-side { cursor: default; position: absolute; right: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.right-mask-side { cursor: default; position: absolute; left: 50%; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); will-change: transform; }

.left-mask-side { cursor: default; position: absolute; right: 50%; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); will-change: transform; }

.right-flip-side { cursor: default; position: absolute; right: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.right-side { cursor: default; position: absolute; right: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); will-change: transform; }

.left-side { cursor: default; position: absolute; left: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); will-change: transform; }

.double.left-side { left: auto; right: 50%; }

.double.right-side { right: auto; left: 50%; }

.right-mask-side .right-side { left: 0px; }

.left-mask-side .left-side { right: 0px; left: auto; }

.right-single-mask-side .right-side { left: 0px; }

.left-single-mask-side .left-side { right: 0px; left: auto; }

.center-side { cursor: default; position: absolute; inset: 0px; margin: auto; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.flip-side { cursor: default; position: absolute; left: 100%; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.flip-vertical-side { cursor: default; position: absolute; top: 100%; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.flip-hard-left-side { cursor: default; position: absolute; background-color: white; left: auto; right: auto; background-repeat: no-repeat; background-position: center center; perspective-origin: right center; transform-style: preserve-3d; transform-origin: 100% 50%; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.flip-hard-right-side { cursor: default; position: absolute; background-color: white; right: 0px; left: auto; background-repeat: no-repeat; background-position: center center; perspective-origin: left center; transform-style: preserve-3d; transform-origin: 0px 50%; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.flip-hard-up-side { cursor: default; position: absolute; background-color: white; top: auto; bottom: auto; background-repeat: no-repeat; background-position: center center; perspective-origin: center bottom; transform-style: preserve-3d; transform-origin: 50% 100%; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.flip-hard-down-side { cursor: default; position: absolute; background-color: white; bottom: 0px; top: auto; background-repeat: no-repeat; background-position: center center; perspective-origin: center top; transform-style: preserve-3d; transform-origin: 50% 0px; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.flip-thick { height: 100%; width: 6px; overflow: hidden; visibility: hidden; z-index: 20; position: absolute; left: -6px; background: rgb(218, 218, 218); box-shadow: rgb(102, 102, 102) 0px 0px 2px inset; }

.flip-vertical-thick { width: 100%; height: 6px; overflow: hidden; visibility: hidden; z-index: 20; position: absolute; top: -6px; background: rgb(218, 218, 218); box-shadow: rgb(102, 102, 102) 0px 0px 2px inset; }

.flip-hard-left-side .flip-thick { left: -6px; transform-origin: 100% 50%; }

.flip-hard-right-side .flip-thick { left: 100%; transform-origin: 0px 50%; }

.flip-hard-up-side .flip-vertical-thick { top: -6px; transform-origin: 50% 100%; }

.flip-hard-down-side .flip-vertical-thick { top: 100%; transform-origin: 50% 0px; }

.vertical-mask { cursor: default; position: absolute; bottom: 50%; top: auto; transform-origin: 50% 100%; overflow: hidden; backface-visibility: hidden; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.single-book-vertical-mask { cursor: default; position: absolute; bottom: 100%; top: auto; transform-origin: 50% 100%; overflow: hidden; backface-visibility: hidden; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.single-book-right-vertical-mask { cursor: default; position: absolute; bottom: 0px; top: auto; transform-origin: 50% 100%; overflow: hidden; backface-visibility: hidden; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.down-single-mask-side { cursor: default; position: absolute; top: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.up-single-mask-side { cursor: default; position: absolute; bottom: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.down-mask-side { cursor: default; position: absolute; top: 50%; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.up-mask-side { cursor: default; position: absolute; bottom: 50%; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.down-flip-side { cursor: default; position: absolute; bottom: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.down-side { cursor: default; position: absolute; bottom: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.up-side { cursor: default; position: absolute; top: 0px; overflow: hidden; background-repeat: no-repeat; background-position: center center; transform: translate3d(0px, 0px, 0px) rotate(0deg); }

.double.up-side { top: auto; bottom: 50%; }

.double.down-side { bottom: auto; top: 50%; }

.down-mask-side .down-side { top: 0px; }

.up-mask-side .up-side { bottom: 0px; top: auto; }

.down-single-mask-side .down-side { top: 0px; }

.up-single-mask-side .up-side { bottom: 0px; top: auto; }

.side-content { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; z-index: 1; }

.attachments-content { width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; z-index: 4; }

.side-highlight { width: 100%; height: 100%; position: absolute; left: 0px; top: 0px; opacity: 0.8; z-index: 1; }

.thickness { position: absolute; height: 100%; perspective: 500px; cursor: pointer; }

.thickness .top_part { position: relative; height: 50px; width: 100%; }

.thickness .center_part { position: relative; height: auto; width: 100%; }

.thickness .bottom_part { position: relative; height: 50px; width: 100%; }

.thickness .part { background-repeat: no-repeat; }

.left_thickness .top_part { background: url("icon/thickness_left.png") right 0px; }

.left_thickness .center_part { background: url("icon/thickness_left.png") right -50px; }

.left_thickness .bottom_part { background: url("icon/thickness_left.png") right bottom; }

.right_thickness .top_part { background: url("icon/thickness.png") left 0px; }

.right_thickness .center_part { background: url("icon/thickness.png") left -50px; }

.right_thickness .bottom_part { background: url("icon/thickness.png") left bottom; }

.left_thickness { transform-origin: 100% 0px; }

.right_thickness { transform-origin: 0px center; }

.thickness .shadow { position: absolute; z-index: -1; transform-style: preserve-3d; top: 0px; left: 0px; width: 100%; height: 100%; }

.left_thickness .shadow { box-shadow: rgba(125, 125, 125, 0.7) -3px 0px 6px; transform-origin: 100% 0px; transform: rotateY(-20deg) scaleX(1) scaleZ(1); margin-left: 1px; }

.right_thickness .shadow { margin-left: -1px; box-shadow: rgba(125, 125, 125, 0.7) 3px 0px 6px; transform-origin: 0px center; transform: rotateY(20deg) scaleX(1) scaleZ(1); }

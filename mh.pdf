.bookmark-form-info-btn { position: relative; display: inline-block; vertical-align: middle; box-sizing: border-box; width: 16px; height: 16px; margin-left: 5px; padding: 0px; line-height: 0; border-radius: 50%; z-index: 1; }

.rightToLeft .bookmark-form-info-btn { margin-left: 0px; margin-right: 5px; }

.bookmark-form-info-btn__i { display: block; position: relative; top: 0px; line-height: 18px; text-align: center; font-size: 14px; font-style: italic; font-family: Calibri, Helvetica, serif; pointer-events: none; }

.bookmark-form-info-btn__tip { position: absolute; top: 100%; left: 50%; margin-top: 6px; padding: 8px 10px; min-width: 200px; max-width: 220px; font-size: 14px; line-height: 1.4; font-style: normal; font-weight: normal; text-align: left; color: rgb(255, 255, 255); background: rgba(0, 0, 0, 0.88); border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.35) 0px 2px 8px; white-space: normal; z-index: 10050; display: none; pointer-events: none; transform: translateX(-50%); font-family: arial, sans-serif; }

.rightToLeft .bookmark-form-info-btn__tip { text-align: right; }

.bookmark-form-info-btn__tip::after { content: ""; position: absolute; bottom: 100%; left: 50%; margin-left: -5px; border-width: 5px; border-style: solid; border-color: transparent transparent rgba(0, 0, 0, 0.88); border-image: initial; }

.bookmark-form-info-btn:hover .bookmark-form-info-btn__tip, .bookmark-form-info-btn:focus .bookmark-form-info-btn__tip, .bookmark-form-info-btn:focus-within .bookmark-form-info-btn__tip { display: block; }

.left_bookmark_bar { position: absolute; overflow: hidden; z-index: 1; height: 65px; top: -65px; }

.left_bookmark_bar.vertical { transform-origin: 100% 100%; transform: rotate(-90deg); }

.right_bookmark_bar { position: absolute; overflow: hidden; z-index: 1; height: 65px; top: -65px; }

.right_bookmark_bar.vertical { transform-origin: 0px 100%; transform: rotate(90deg); }

.up_bookmark_bar { position: absolute; overflow: hidden; z-index: 1; height: 65px; top: -65px; }

.up_bookmark_bar.vertical { transform-origin: 100% 100%; transform: rotate(-90deg); }

.down_bookmark_bar { position: absolute; overflow: hidden; z-index: 1; height: 65px; left: -100%; bottom: 0px; top: auto; transform-origin: 100% 100%; transform: rotate(-180deg); }

.down_bookmark_bar.vertical { left: 0px; transform: rotate(90deg); }

.left_bookmark_bar.side_bookmark_column.horizontal_text, .right_bookmark_bar.side_bookmark_column.horizontal_text, .up_bookmark_bar.side_bookmark_column.horizontal_text, .down_bookmark_bar.side_bookmark_column.horizontal_text { overflow: visible; transform: none; transform-origin: 0px center; }

.down_bookmark_bar.side_bookmark_column.horizontal_text { transform: none; left: auto; }

.left_bookmark_bar.side_bookmark_column.horizontal_text .bookmark_item, .up_bookmark_bar.side_bookmark_column.horizontal_text .bookmark_item { top: 0px; left: auto; right: 0px; box-sizing: border-box; width: 66px; min-width: 66px; max-width: 130px; height: 75px; min-height: 75px; max-height: 75px; overflow-y: auto; align-items: center; border-radius: 3px 0px 0px 3px; }

.right_bookmark_bar.side_bookmark_column.horizontal_text .bookmark_item, .down_bookmark_bar.side_bookmark_column.horizontal_text .bookmark_item { top: 0px; left: 0px; right: auto; box-sizing: border-box; width: 66px; min-width: 50px; max-width: 130px; height: 75px; min-height: 75px; max-height: 75px; overflow-y: auto; align-items: center; border-radius: 0px 3px 3px 0px; }

.bookmark_item { top: 30px; width: auto; min-width: 50px; max-width: 130px; height: 65px; padding: 10px; cursor: pointer; border-radius: 3px 3px 0px 0px; position: absolute; box-shadow: rgba(51, 51, 51, 0.7) 1px 0px 3px 0px; display: flex; }

.bookmark_caption { font-family: Tahoma, "sans-serif", Arial; font-size: 12px; text-align: center; color: rgb(238, 238, 238); overflow-wrap: anywhere; box-sizing: border-box; }


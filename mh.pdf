@charset "utf-8";

@keyframes loadingAnimate { 
  0% { transform: rotateY(0deg) scale(0.8); }
  100% { transform: rotateY(-180deg) scale(0.8); }
}

@-webkit-keyframes loadingAnimate { 
  0% { transform: rotateY(0deg) scale(0.8); }
  100% { transform: rotateY(-180deg) scale(0.8); }
}

.loadingRun { animation: 1.2s ease 0s infinite normal none running loadingAnimate; }

.loader, .loader::after { border-radius: 50%; width: 60px; height: 60px; }

.loader { margin: 60px auto; font-size: 10px; position: relative; text-indent: -9999em; border-width: 1.1em; border-style: solid; border-color: rgba(255, 255, 255, 0.2) rgba(255, 255, 255, 0.2) rgba(255, 255, 255, 0.2) rgb(255, 255, 255); transform: translateZ(0px); animation: 1.1s linear 0s infinite normal none running load8; }

@-webkit-keyframes load8 { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes load8 { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

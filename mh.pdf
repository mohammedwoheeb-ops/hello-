.reader_form_phone .date { font-size: 12px; color: rgb(153, 153, 153); line-height: 1.5; margin-bottom: 20px; word-break: break-all; }

.reader_form_phone .notes { font-size: 12px; color: rgb(153, 153, 153); line-height: 1.5; margin-bottom: 20px; word-break: break-all; }

.reader_form_phone .guide { line-height: 1.67; margin-bottom: 25px; text-align: justify; overflow-wrap: break-word; font-size: 16px; color: rgb(153, 153, 153); text-indent: 2em !important; background-color: transparent !important; }

.phoneBottomBar .mixButton { font-size: 12px; width: 40px; height: 52px; position: absolute; cursor: pointer; text-align: center; }

.phoneBottomBar .mixButton img { height: 20px; left: 0px; width: 20px; position: absolute; top: 0px; bottom: 0px; margin: auto; }

.phoneBottomBar .mixButton .svg { height: 20px; left: 1px; width: 20px; position: absolute; top: 0px; bottom: 0px; margin: auto; }

.phoneBottomBar .mixButton .icon { overflow: hidden; position: absolute; left: 9px; top: 9px; width: 22px; height: 22px; }

.phoneBottomBar .mixButton span { bottom: 0px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; color: white; line-height: 20px; display: block; width: 40px; position: absolute; }

.phoneBottomBar .mixButton img.custom { left: 0px; }

.phoneTopBar .mixButton { font-size: 12px; width: 40px; height: 52px; position: absolute; cursor: pointer; text-align: center; }

.phoneTopBar .mixButton img { max-height: 40px; position: absolute; top: 10px; left: 0px; bottom: 0px; margin: auto; }

.phoneTopBar .mixButton .svg { height: 20px; left: 1px; width: 20px; position: absolute; top: 0px; bottom: 0px; margin: auto; }

.phoneTopBar .mixButton .icon { overflow: hidden; position: absolute; left: 9px; top: 9px; width: 22px; height: 22px; }

.phoneTopBar .mixButton span { bottom: 0px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; color: white; line-height: 20px; display: block; width: 40px; position: absolute; }

.phoneTopBar .mixButton img.custom { left: 0px; }

.phoneTopBar .textButton { font-size: 12px; width: 40px; height: 40px; position: absolute; cursor: pointer; text-align: center; }

.phoneTopBar .textButton .svg { display: none; }

.phoneTopBar .textButton .icon { display: none; }

.phoneTopBar .textButton span { top: 10px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; color: white; line-height: 20px; display: block; margin: 0px 0px 0px -15px; width: 70px; position: absolute; }

.phoneBottomBar .textButton { font-size: 12px; width: 40px; height: 40px; position: absolute; cursor: pointer; text-align: center; }

.phoneBottomBar .textButton img { display: none; }

.phoneBottomBar .textButton .svg { display: none; }

.phoneBottomBar .textButton .icon { display: none; }

.phoneBottomBar .textButton span { top: 10px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; color: white; line-height: 20px; display: block; margin: 0px 0px 0px -15px; width: 70px; position: absolute; }

.bg-bottom-wrap { display: grid; grid-template-columns: 1.2fr 2fr 0.6fr; height: 60px; position: absolute; width: 90%; left: 5%; z-index: 99; top: 50%; transform: translateY(-50%); }

.bg-bottom-wrap > div { height: 100%; }

.box-logo { background-repeat: no-repeat; background-position: center center; background-size: contain; }

.box-time { text-align: center; display: flex; flex-direction: column; justify-content: center; }

.box-time .time { color: rgb(116, 116, 116); font-size: 16px; }

.box-time .slogan { color: rgb(198, 198, 198); font-size: 12px; }

.box-qr { background-repeat: no-repeat; background-position: center center; background-size: contain; }

.reader_form_phone .page { position: relative; margin-bottom: 20px; }

.reader_form_phone .pageImage { height: auto; width: 100%; margin-left: 50%; transform: translate(-50%, 0px); border: 1px solid rgb(153, 153, 153); }

.reader_form_phone .mask { position: absolute; z-index: 1; left: 0px; top: 0px; width: 100%; height: 100%; }

.bg-bottom-wrap2 { display: grid; grid-template-columns: 1fr 2fr 1fr; height: 60px; position: absolute; bottom: 5%; width: 80%; left: 5%; z-index: 3; top: 20px; background: rgb(246, 247, 249); border-radius: 8px; padding: 0px 5%; }

.bg-bottom-wrap2 > div { height: 100%; }

.box-logo2 { background-repeat: no-repeat; background-position: center center; background-size: contain; margin-right: 15px; }

.box-time2 { display: flex; flex-direction: column; justify-content: center; text-align: left; }

.box-time2 .time2 { color: rgb(172, 172, 173); font-size: 12px; line-height: 20px; }

.box-time2 .slogan2 { color: rgb(0, 0, 0); font-size: 14px; line-height: 20px; }

.box-qr2 { background-repeat: no-repeat; background-position: center center; background-size: contain; }

.phoneReaderToolbar { width: 100%; height: 36px; position: absolute; bottom: 27px; z-index: 100; }

.phoneReaderToolbar .button { width: 36px; height: 36px; position: absolute; top: 0px; border-radius: 18px; background: rgba(0, 0, 0, 0.8); }

.phoneReaderToolbar .home { left: 30px; }

.phoneReaderToolbar .zoom { width: 92px; left: 50%; margin-left: -46px; }

.phoneReaderToolbar .enlarge { width: 36px; height: 36px; position: absolute; left: 10px; }

.phoneReaderToolbar .reduce { width: 36px; height: 36px; position: absolute; right: 10px; }

.phoneReaderToolbar .list { right: 30px; }

.phoneReaderToolbar .top { right: 30px; top: -56px; }

.phoneReaderToolbar .backtop { right: 30px; }

.phoneReaderToolbar .reader-list { left: 30px; }

.phoneReaderToolbar .button img { position: absolute; margin: auto; inset: 0px; }

.phoneTopBar .topRightButton { position: absolute; top: initial; right: 12px; height: 100%; }

.appear_win10 { position: absolute; opacity: 0; z-index: 1001; left: 0px; top: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); text-align: center; vertical-align: middle; }

.appear_win10 .main_dom { position: relative; display: inline-block; left: 0px; top: 0px; }

.appear_win10::after { content: ""; display: inline-block; height: 100%; vertical-align: middle; }

.button_hover:hover { opacity: 0.7; }

.button_hover:active { opacity: 0.2; }

.disable { opacity: 0.2; }

.usable { opacity: 1; }

::-webkit-scrollbar { height: 0px; width: 0px; }

::-webkit-scrollbar-button { height: 0px; width: 0px; }

.anno-noteAdd { cursor: pointer; position: absolute; right: -22px; z-index: 1111; top: 0px; width: 18px; height: 22px; background: url("./icon/note_page_add.png") right top no-repeat; }

.anno-noteAdd:hover { opacity: 0.85; }

.modern-color-panel { padding: 0px 20px 20px; }

.modern-color-panel-title { text-align: center; font-size: 17px; font-weight: 600; color: var(--modern-text-primary,#fff); margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--modern-border-primary,rgba(236,236,236,0.1)); }

.modern-color-grid-container { margin-bottom: 20px; }

.modern-color-grid { position: relative; width: 100%; height: 200px; border-radius: 8px; cursor: crosshair; overflow: hidden; background-color: rgb(253, 198, 6); background-image: linear-gradient(to top, rgb(0, 0, 0), rgba(0, 0, 0, 0)), linear-gradient(to right, rgb(255, 255, 255), rgba(255, 255, 255, 0)); }

.modern-color-point { box-sizing: border-box; position: absolute; width: 28px; height: 28px; border: 6px solid var(--modern-text-primary,#fff); border-radius: 50%; margin-left: -10px; margin-top: -10px; pointer-events: none; box-shadow: rgba(44, 47, 53, 0.12) 0px 0px 8px 0px; z-index: 10; }

.modern-color-hue-slider-container { margin-bottom: 20px; }

.modern-color-hue-slider { position: relative; width: 100%; height: 18px; border-radius: 20px; background: linear-gradient(90deg, rgb(255, 0, 0) 0px, rgb(255, 225, 0) 16.83%, rgb(9, 255, 236) 50%, rgb(83, 7, 255) 71.61%, rgb(255, 32, 233) 88.68%, rgb(255, 0, 0) 100%); cursor: pointer; }

.modern-color-hue-slider-handle { box-sizing: border-box; position: absolute; width: 28px; height: 28px; background: rgb(255, 255, 255); border: 6px solid rgb(255, 255, 255); border-radius: 50%; top: 50%; transform: translateY(-50%); margin-left: -14px; box-shadow: rgba(44, 47, 53, 0.14) 0px 0px 12px 0px; z-index: 10; transition: background-color 0.1s; }

.modern-color-hue-slider-handle:active { cursor: grabbing; }

.modern-color-presets { flex: 1 1 0%; display: flex; align-items: center; justify-content: center; gap: 12px; }

.modern-color-preset-swatch { width: 24px; height: 24px; border-radius: 4px; cursor: pointer; border: 2px solid transparent; outline: transparent solid 2px; }

.modern-color-preset-swatch.selected { outline-color: var(--modern-accent-primary,#53af32); border-color: var(--modern-text-primary,#fff); }

.modern-color-current-display { display: flex; justify-content: space-between; align-items: center; }

.modern-color-current-swatch { box-sizing: border-box; width: 48px; height: 48px; border-radius: 8px; }

.modern-goto-page-menu { position: absolute; width: 100%; height: 104px; z-index: 98; bottom: 60px; overflow: hidden; border-radius: 20px 20px 0px 0px; }

.modern-goto-page-background { position: absolute; width: 100%; height: 104px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); opacity: 1; z-index: -1; }

.modernGotoPageContent { box-sizing: border-box; padding: 12px 20px; width: 100%; height: 60px; display: flex; align-items: center; justify-content: space-between; }

.modernGotoPageContent img { cursor: pointer; margin: 4px -2px 4px 0px; max-width: 20px; max-height: 20px; pointer-events: none; }

.modernGotoPageContent .btn { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; overflow: visible; }

.modernGotoPageContent .btn div { width: 20px; height: 20px; }

.modernGotoPageContent .inputButton { box-sizing: border-box; display: inline-block; position: relative; overflow: visible; width: 206px; height: 36px; }

.modernGotoPageContent .inputButton input { padding: 0px; text-align: center; border-width: 0px; width: 100%; height: 100%; border-radius: 20px; position: absolute; left: 0px; top: 0px; background: var(--modern-bg-octonary,rgba(0,0,0,0.2)); color: var(--modern-text-primary,#fff); }

.modernGotoPageContent .inputButton.enablePageBack { width: 90px; }

.modernGotoPageContent .goBtn { width: 30px; height: 30px; top: 0px; right: 0px; cursor: pointer; z-index: 5; position: absolute; }

.modernGotoPageContent .goBtn div { width: 20px; height: 20px; margin: 4px; }

.modern-goto-page-slider-wrapper { position: relative; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0px 24px; width: 100%; height: 44px; }

.modern-goto-page-slider { position: relative; width: 100%; height: 18px; background: var(--modern-bg-octonary,rgba(0,0,0,0.2)); border-radius: 100px; }

.modern-goto-page-slider-enter { position: absolute; top: 0px; width: 0px; height: 18px; border-radius: 100px; background: var(--modern-bg-nonary,rgba(255,255,255,0.6)); }

.modern-goto-page-slider-enter[data-direction="left"] { left: 0px; }

.modern-goto-page-slider-enter[data-direction="right"] { right: 0px; }

.modern-goto-page-pointer { cursor: pointer; background: var(--modern-text-primary,#fff); position: absolute; top: -6px; width: 28px; height: 28px; border-radius: 50%; box-shadow: 0 0 12px 0 var(--modern-border-primary,#ececec1a); }

.modern-goto-page-pointer[data-direction="left"] { left: 12px; }

.modern-goto-page-pointer[data-direction="right"] { right: 12px; }

.modern-flip-btn { border-radius: 12px; display: flex; align-items: center; justify-content: center; }

.modern-gallery-panel { display: flex; flex-direction: column; width: 100%; height: 100%; box-sizing: border-box; padding: 12px 12px 16px; gap: 12px; }

.modern-gallery-viewer { position: relative; width: 100%; height: min(35vh, 35dvh); min-height: 0px; overflow: hidden; flex-shrink: 0; border-radius: 8px; gap: 16px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-gallery-image { display: none; position: relative; width: 100%; height: 100%; object-fit: contain; cursor: pointer; opacity: 0; transition: opacity 0.5s ease-in-out; }

.modern-gallery-image.is-show { display: block; }

.modern-gallery-image.fadeIn { opacity: 1; }

.modern-gallery-thumbs { display: flex; gap: 16px; flex-shrink: 0; width: 100%; overflow: auto hidden; scrollbar-width: none; }

.modern-gallery-thumbs::-webkit-scrollbar { display: none; }

.modern-gallery-thumbs:has(.modern-gallery-thumb:only-of-type) { justify-content: center; }

.modern-gallery-thumb { position: relative; width: 72px; height: 95px; border-radius: 4px; opacity: 0.6; flex: 0 0 auto; box-sizing: border-box; padding: 2px; overflow: hidden; border: 2px solid transparent; outline: transparent solid 2px; background: none; cursor: pointer; }

.modern-gallery-thumb img { width: 100%; height: 100%; object-fit: contain; }

.modern-gallery-thumb.active { border-color: var(--modern-accent-primary,#53af32); opacity: 1; }

.modern-gallery-loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0, 0, 0, 0.7); color: white; padding: 8px 16px; border-radius: 4px; font-size: 14px; z-index: 10; }

.modern-language-list { display: flex; flex-direction: column; gap: 0px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 8px; padding: 0px 16px; }

.modern-language-item { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; padding: 16px 0px; cursor: pointer; transition: 0.2s; position: relative; border-bottom: .5px solid var(--modern-border-primary,#ececec1a); }

.modern-language-item:last-child { border-bottom: 0px; }

.modern-language-name { font-size: 16px; font-weight: 500; color: var(--modern-text-primary,#fff); flex: 1 1 0%; user-select: none; }

.modern-language-check { display: none; align-items: center; justify-content: center; width: 20px; height: 20px; color: var(--modern-accent-primary,#53af32); flex-shrink: 0; margin-left: 12px; }

.modern-language-item.is-selected .modern-language-check { display: flex; }

.modern-language-check svg { width: 100%; height: 100%; stroke: currentcolor; }

.modern-language-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; }

.modern-language-empty-icon { width: 48px; height: 48px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-bottom: 16px; display: flex; align-items: center; justify-content: center; }

.modern-language-empty-icon svg { width: 100%; height: 100%; stroke: currentcolor; }

.modern-language-empty-text { font-size: 14px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); line-height: 1.5; }

[dir="rtl"] .modern-language-item { border-right-width: medium; border-right-style: none; border-right-color: currentcolor; }

[dir="rtl"] .modern-language-check { margin-left: 0px; margin-right: 12px; }

.modern-annotation-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; gap: 8px; overflow-x: auto; }

.modern-annotation-tool { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 36px; height: 36px; cursor: pointer; transition: 0.2s; flex-shrink: 0; }

.modern-annotation-tool.active { border-radius: 8px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); color: var(--modern-accent-primary,#53af32); }

.modern-annotation-tool.active svg path, .modern-annotation-tool.active svg circle { stroke: var(--modern-accent-primary,#53af32); }

.modern-annotation-tool.disabled { opacity: 0.3; cursor: not-allowed; pointer-events: none; }

.modern-annotation-tool.disabled svg path, .modern-annotation-tool.disabled svg circle { stroke: rgb(142, 142, 147); }

.modern-annotation-tool svg { width: 16px; height: 16px; }

.modern-annotation-controls { padding: 16px 20px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); display: none; }

.modern-annotation-controls.show { display: block; }

.modern-annotation-panel .widthSlider { position: relative; width: 100%; height: 100%; cursor: pointer; }

.modern-annotation-panel .widthSliderBg { position: absolute; top: 50%; width: 100%; height: 10px; border-radius: 10px; transform: translateY(-50%); background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-annotation-panel .widthSliderEnter { position: absolute; left: 0px; height: 10px; background: var(--modern-text-primary,#fff); border-radius: 10px; transform: translateY(-50%); top: 50%; transition: width 0.1s; }

.modern-annotation-panel .widthSliderPointer { position: absolute; width: 20px; height: 20px; cursor: pointer; transform: translateY(-50%); top: 50%; transition: left 0.1s; }

.modern-annotation-panel .widthSliderPointer span { border-radius: 50%; background: var(--modern-text-primary,#fff); position: absolute; width: 20px; height: 20px; transition: 0.1s; box-shadow: 0 0 12px 0 var(--modern-border-primary,#ececec1a); }

.modern-annotation-panel .widthTooltip { display: none; z-index: 10; box-sizing: border-box; position: absolute; top: -25px; left: 50%; transform: translateX(-50%); width: 29px; height: 32px; line-height: 32px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); text-align: center; border-radius: 4px; font-size: 12px; color: var(--modern-text-primary,#fff); pointer-events: none; white-space: nowrap; }

.modern-annotation-panel .widthTooltip::after { content: ""; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); width: 0px; height: 0px; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 5px solid rgb(0, 0, 0); }

.modern-annotation-slider-container { margin-bottom: 16px; }

.modern-annotation-slider { position: relative; width: 100%; height: 18px; background: rgb(243, 243, 244); border-radius: 100px; }

.slider-checkerboard-bg { position: absolute; inset: 0px; pointer-events: none; z-index: 0; border-radius: inherit; }

.slider-checkerboard-bg svg { width: 100%; height: 100%; display: block; border-radius: 100px; }

.slider-gradient-overlay { position: absolute; inset: 0px; pointer-events: none; z-index: 1; border-radius: inherit; }

.modern-annotation-slider-handle { box-sizing: border-box; position: absolute; top: 50%; left: 30%; width: 28px; height: 28px; background: rgb(255, 255, 255); border-radius: 50%; transform: translate(-50%, -50%); box-shadow: rgba(44, 47, 53, 0.14) 0px 0px 12px 0px; }

.modern-annotation-slider-handle:active { cursor: grabbing; transform: translate(-50%, -50%) scale(1.1); }

.modern-slider-tooltip { position: fixed; z-index: 9999; padding: 4px 8px; min-width: 32px; height: 28px; line-height: 20px; background: rgba(0, 0, 0, 0.85); color: rgb(255, 255, 255); font-size: 12px; font-weight: 500; text-align: center; border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px; pointer-events: none; white-space: nowrap; opacity: 0; transition: opacity 0.2s, transform 0.2s; box-sizing: border-box; display: none; align-items: center; justify-content: center; }

.modern-slider-tooltip.show { opacity: 1; }

.modern-slider-tooltip::after { content: ""; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); width: 0px; height: 0px; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 6px solid rgba(0, 0, 0, 0.85); }

.modern-annotation-alpha-gradient-container { margin-bottom: 16px; }

.modern-annotation-alpha-gradient { position: relative; width: 100%; height: 18px; border-radius: 100px; overflow: hidden; background-color: rgb(243, 243, 244); }

.modern-annotation-color-swatches { display: flex; align-items: center; justify-content: center; gap: 12px; }

.modern-annotation-color-swatch { box-sizing: border-box; height: 24px; width: 24px; border-radius: 4px; outline: transparent solid 2px; border: 2px solid transparent; }

.modern-annotation-color-swatch.selected { outline: 2px solid var(--modern-accent-primary,#53af32); border: 2px solid var(--modern-text-primary,#fff); }

.modern-annotation-color-swatch.gradient-swatch { background: linear-gradient(137.49deg, rgb(255, 188, 141) 23.65%, rgb(50, 235, 255) 95.11%); }

.modern-note-container { position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; z-index: 10001; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(10px); animation: 0.3s ease-out 0s 1 normal none running modernNoteFadeIn; }

.modern-note-modal { position: relative; width: 90%; max-width: 500px; background: var(--modern-text-primary,#fff); border-radius: 16px; box-shadow: rgba(0, 0, 0, 0.3) 0px 20px 40px; overflow: hidden; animation: 0.3s ease-out 0s 1 normal none running modernNoteSlideUp; transform: translateY(0px); }

.modern-note-header { padding: 20px 24px 16px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, rgb(248, 249, 250) 0px, rgb(255, 255, 255) 100%); }

.modern-note-title { margin: 0px; font-size: 18px; font-weight: 600; color: var(--modern-text-primary,#fff); letter-spacing: -0.02em; }

.modern-note-close-btn { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; font-size: 24px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); cursor: pointer; padding: 8px; border-radius: 8px; transition: 0.2s; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; }

.modern-note-content { padding: 24px; }

.modern-panel.modern-note-panel { display: flex; flex-direction: column; height: 100%; overflow: auto; }

.modern-note-title-container { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-note-panel-title { font-size: 20px; font-weight: 700; color: var(--modern-text-primary,#fff); line-height: 1.5; text-align: center; letter-spacing: -0.5px; }

.modern-panel.modern-note-panel .modern-panel-title { flex-shrink: 0; margin: 0px; }

.modern-note-time { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-left: 12px; margin-right: auto; flex-shrink: 0; }

.modern-note-delete { box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 5px; font-size: 14px; font-weight: 500; height: 24px; color: var(--modern-text-primary,#fff); cursor: pointer; transition: background-color 0.2s; flex-shrink: 0; user-select: none; }

.modern-note-textarea { width: 100%; flex: 1 1 0%; min-height: 120px; padding: 16px; border: 0px; border-radius: 8px; resize: none; outline: none; transition: 0.2s; box-sizing: border-box; line-height: 1.5; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); font-family: Inter; font-weight: 500; font-size: 14px; color: var(--modern-text-primary,#fff); caret-color: var(--modern-accent-primary,#53af32); overflow-y: auto; }

.modern-note-textarea:focus { caret-color: var(--modern-accent-primary,#53af32); }

.modern-note-textarea::placeholder { color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-note-char-count { text-align: right; font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-top: 8px; font-weight: 500; }

.modern-note-color-section { padding: 0px 24px 20px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-note-color-label { font-size: 14px; font-weight: 500; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }

.modern-note-color-label::before { content: "é¦ƒå¸¹"; font-size: 16px; }

.modern-note-color-picker { display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-start; }

.modern-note-actions { padding: 20px 24px; display: flex; gap: 12px; justify-content: flex-end; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-note-cancel-btn { padding: 12px 24px; border: 1px solid var(--modern-border-primary,#ececec1a); border-radius: 8px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); color: var(--modern-text-secondary,rgba(255,255,255,0.6)); font-size: 16px; font-weight: 500; cursor: pointer; transition: 0.2s; min-width: 80px; }

.modern-note-save-btn { padding: 12px 24px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; background: var(--modern-accent-primary,#53af32); color: var(--modern-text-primary,#fff); font-size: 16px; font-weight: 500; cursor: pointer; transition: 0.2s; min-width: 80px; box-shadow: 0 2px 8px var(--modern-accent-primary,#53af32); }

.modern-note-save-btn:active { transform: translateY(0px); box-shadow: 0 2px 4px var(--modern-accent-primary,#53af32); }

.noteContainer { z-index: 1001; }

.noteSvgIcon { width: 100%; height: 100%; }

.noteSvgIcon svg, .noteSvgIcon > * { pointer-events: none; }

.modern-note-message { position: fixed; top: 20px; right: 20px; padding: 12px 20px; border-radius: 8px; color: var(--modern-text-primary,#fff); font-size: 14px; font-weight: 500; z-index: 10003; animation: 0.3s ease-out 0s 1 normal none running modernNoteSlideIn; box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px; max-width: 300px; overflow-wrap: break-word; }

.modern-note-color-box { display: flex; align-items: center; justify-content: center; height: 32px; gap: 12px; margin-top: 12px; flex-shrink: 0; }

.note-color-item { height: 24px; width: 24px; border-radius: 4px; outline: transparent solid 2px; border: 2px solid transparent; }

.note-color-item.active { outline: 2px solid var(--modern-accent-primary,#53af32); border: 2px solid var(--modern-text-primary,#fff); }

@keyframes modernNoteFadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes modernNoteSlideUp { 
  0% { opacity: 0; transform: translateY(40px) scale(0.95); }
  100% { opacity: 1; transform: translateY(0px) scale(1); }
}

@keyframes modernNoteSlideIn { 
  0% { opacity: 0; transform: translateX(100%); }
  100% { opacity: 1; transform: translateX(0px); }
}

@media (max-width: 768px) {
  .modern-note-modal { width: 95%; margin: 20px; max-height: 90vh; overflow-y: auto; }
  .modern-note-header { padding: 16px 20px 12px; }
  .modern-note-content { padding: 20px; }
  .modern-note-color-section { padding: 0px 20px 16px; }
  .modern-note-actions { padding: 16px 20px; flex-direction: column; }
  .modern-note-cancel-btn, .modern-note-save-btn { width: 100%; padding: 14px 24px; }
  .modern-note-color-picker { justify-content: center; }
}

@media (prefers-reduced-motion: reduce) {
  .modern-note-container, .modern-note-modal, .modern-note-message { animation: auto ease 0s 1 normal none running none; }
  .modern-note-close-btn, .modern-note-cancel-btn, .modern-note-save-btn, .modern-note-textarea { transition: none; }
}

.modern-panel { flex: 1 1 0%; border-radius: 20px 20px 0px 0px; padding: 0px 20px 16px; overflow: auto; font-family: Calibri, Helvetica, Inter; }

.modern-panel-title { font-size: 20px; font-weight: 700; color: var(--modern-text-primary,#FFF); line-height: 1.5; text-align: center; letter-spacing: -0.5px; padding-bottom: 8px; margin-bottom: 12px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-panel-area { border-radius: 8px; padding: 16px 12px; gap: 12px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-panel-area-setting { padding: 0px; }

.modern-panel-area .item { display: flex; align-items: center; justify-content: space-between; padding: 0px 16px; height: 50px; }

.modern-panel-area .item .title { font-weight: bold; font-size: 14px; color: var(--modern-text-primary,#fff); }

.modern-video-gallery .video { width: 100%; height: 191px; border-radius: 8px; }

.modern-video-gallery .info .title { font-weight: bold; font-size: 14px; color: var(--modern-text-primary,#fff); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }

.modern-video-gallery .info .description { margin-top: 12px; font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-video-thumbnail-list { padding-top: 16px; border-top: .5px solid var(--modern-border-primary,#ececec1a); }

.modern-video-list-title { font-size: 16px; font-weight: bold; color: var(--modern-text-primary,#fff); }

.modern-video-thumbnail-scroll { display: flex; overflow-x: auto; gap: 12px; padding: 12px 0px; scroll-behavior: smooth; }

.modern-video-thumbnail-scroll { }

@supports (scrollbar-width:none) {
  .modern-video-thumbnail-scroll { scrollbar-width: none; }
}

.modern-video-thumbnail-scroll::-webkit-scrollbar { display: none; }

.modern-video-thumbnail-item { flex-shrink: 0; width: 140px; cursor: pointer; transition: transform 0.2s; position: relative; }

.modern-video-thumbnail-image { width: 140px; height: 90px; background: center center / cover rgb(245, 245, 245); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); position: relative; overflow: hidden; }

.modern-video-thumbnail-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 32px; height: 32px; background: rgba(0, 0, 0, 0.7); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--modern-text-primary,#fff); opacity: 0; transition: opacity 0.2s; }

.modern-video-thumbnail-item:hover .modern-video-thumbnail-play { opacity: 1; }

.modern-video-thumbnail-item.active .modern-video-thumbnail-play { opacity: 1; background: var(--modern-accent-primary,#53af32); }

.modern-video-thumbnail-title { margin-top: 8px; font-size: 12px; color: var(--modern-text-primary,#fff); font-weight: bold; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }

.modern-video-thumbnail-desc { margin-top: 4px; font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.modern-video-thumbnail-item.active .modern-video-thumbnail-title { color: var(--modern-accent-primary,#53af32); font-weight: 600; }

.modern-video-gallery .info { margin: 16px 0px; }

.modern-video-gallery .video_list { padding-top: 16px; margin-bottom: 12px; border-top: .5px solid var(--modern-border-primary,#ececec1a); font-weight: bold; font-size: 14px; color: var(--modern-text-primary,#fff); }

.modern-video-gallery .video_list .title { padding-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; white-space: normal; }

.modern-video-gallery .item .thumbnail { width: 141px; height: 92px; border-radius: 4px; }

.modern-video-gallery .item .description { color: var(--modern-text-secondary,rgba(255,255,255,0.6)); font-size: 12px; }

.modern-panel-preview { display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; margin-bottom: 12px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-picture-list { position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }

.modern-panel-arrow-btn { width: 36px; height: 36px; border-radius: 50%; background: rgba(235, 235, 239, 0.55); display: flex; align-items: center; justify-content: center; }

.modern-panel-arrow-btn-left { position: absolute; left: -56px; top: 39px; }

.modern-panel-arrow-btn-right { position: absolute; right: -56px; top: 39px; }

.modern-picture-list .thumbnail { box-sizing: border-box; position: relative; display: flex; align-items: center; flex-direction: column; gap: 10px; border-radius: 8px; }

.modern-picture-list .thumbnail img { box-sizing: border-box; object-fit: cover; border-radius: 8px; border: 1px solid var(--modern-panel-border,#ececec1a); width: 80px !important; height: 114px !important; }

.modern-picture-list .page { font-size: 14px; color: var(--modern-text-primary,#fff); }

.modern-picture-list .leftBtn, .modern-picture-list .rightBtn { width: 28px; height: 28px; border-radius: 50%; background: rgba(255, 255, 255, 0.95); border: 1px solid var(--modern-border-primary,#ececec1a); cursor: pointer; transition: 0.2s; position: absolute; top: 50%; transform: translateY(-50%); }

.modern-picture-list .leftBtn { left: -14px; }

.modern-picture-list .rightBtn { right: -14px; }

.modern-panel-options { display: flex; flex-direction: column; gap: 8px; padding: 12px; border-radius: 8px; background: var(--modern-bg-quaternary,rgba(255,255,255,0.06)); }

.modern-panel-option { display: flex; align-items: center; gap: 12px; padding: 12px 4px; cursor: pointer; transition: 0.2s; border-bottom: .5px solid var(--modern-border-primary,#ececec1a); }

.modern-panel-option:last-child { border-bottom: 0px; }

.modern-panel-option.no-border { border-bottom: 0px; }

.modern-panel-option .modern-panel-text { color: var(--modern-text-primary,#fff); font-weight: 500; }

.modern-panel-radio { box-sizing: border-box; width: 16px; height: 16px; border-radius: 50%; border: 1px solid rgb(108, 117, 125); position: relative; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); transition: 0.2s; flex-shrink: 0; }

.modern-panel-option.active .modern-panel-radio { border: 5px solid var(--modern-accent-primary,#53af32); }

.modern-panel-text { font-size: 16px; font-weight: 500; flex-shrink: 0; white-space: nowrap; }

.modern-panel-input-wrap { flex: 1 1 0%; margin-left: 12px; min-width: 0px; }

.modern-panel-input { width: 100%; padding: 8px 12px; border: 1px solid var(--modern-border-primary,#ececec1a); border-radius: 8px; font-size: 14px; background: var(--modern-text-primary,#fff); outline: none; transition: border-color 0.2s; box-sizing: border-box; }

.modern-panel-input:focus { border-color: var(--modern-accent-primary,#53af32); }

.modern-panel-option.active .modern-panel-input { background: var(--modern-text-primary,#fff); color: rgb(28, 28, 30); }

.modern-panel-expand-wrap { border: 1px solid var(--modern-border-primary,#ececec1a); border-radius: 6px; }

.modern-panel-expand-list { padding: 12px 16px; }

.modern-panel-expand-item { display: flex; align-items: center; gap: 12px; height: 40px; padding: 0px 8px; border-radius: 8px; transition: background 0.2s; }

.modern-panel-expand-item .text { font-size: 14px; color: var(--modern-text-primary,#fff); font-weight: 500; }

.modern-panel-expand-item .modern-attach-radio { display: none !important; }

.radio-item { display: flex; align-items: center; height: 40px; border-radius: 8px; transition: background 0.2s; cursor: pointer; }

.radio-input { display: none; }

.radio-label { display: flex; align-items: center; gap: 12px; cursor: pointer; width: 100%; font-size: 14px; color: var(--modern-text-primary,#fff); font-weight: 500; }

.radio-custom { box-sizing: border-box; width: 16px; height: 16px; border: 1px solid var(--modern-border-primary,#ececec1a); border-radius: 4px; position: relative; transition: 0.2s; flex-shrink: 0; }

.radio-text { overflow-wrap: anywhere; overflow: auto; max-height: 100%; }

.radio-input:checked + .radio-label .radio-custom { border-color: var(--modern-accent-primary,#53af32); background: var(--modern-accent-primary,#53af32); }

.radio-input:checked + .radio-label .radio-custom::after { content: ""; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 8px; height: 8px; background: var(--modern-text-primary,#fff); border-radius: 50%; }

.radio-input:checked + .radio-label { color: var(--modern-accent-primary,#53af32); font-weight: 600; }

.drawer-panel { position: absolute; bottom: 0px; left: 0px; right: 0px; height: auto; background: var(--modern-bg-secondary,#2f5023); box-shadow: none; transform: translateY(100%); opacity: 0; visibility: hidden; transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out, opacity 0.3s ease-in-out, visibility 0.3s ease-in-out; z-index: 1000; border-top-left-radius: 20px; border-top-right-radius: 20px; font-family: Calibri, Helvetica, Inter; }

.drawer-panel .button:hover { opacity: 1; }

.drawer-panel.expanded { border-top-left-radius: 0px; border-top-right-radius: 0px; }

.drawer-content { display: flex; flex-direction: column; height: 100%; flex: 1 1 0%; overflow: hidden; }

.drawer-drag-bar-wrapper { flex-shrink: 0; position: relative; width: 100%; height: 30px; box-sizing: border-box; display: flex; justify-content: center; }

.drawer-drag-bar { width: 40px; height: 6px; background: rgb(204, 204, 204); border-radius: 3px; cursor: grab; flex-shrink: 0; pointer-events: none; user-select: none; margin-top: 8px; }

.drawer-bottom-spacer { background: transparent; flex-shrink: 0; }

.drawer-footer { flex-shrink: 0; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 20px; border-top: .5px solid var(--modern-border-primary,#ececec1a); }

.drawer-footer-single { height: 52px; padding: 0px; }

.drawer-button { flex: 1 1 0%; margin: 0px; padding: 0px; height: 44px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; font-size: 14px; font-weight: bold; font-family: Calibri, Helvetica, Inter; cursor: pointer; transition: 0.2s; }

.drawer-button-cancel { background: var(--modern-bg-senary,rgba(255,255,255,0.08)); color: var(--modern-text-primary,#fff); }

.drawer-single-button-cancel { height: 100%; background: var(--modern-bg-secondary,#2f5023); color: var(--modern-text-primary,#fff); border-radius: 0px; }

.drawer-button-confirm { background: var(--modern-bg-tertiary,#fff); color: var(--modern-bg-primary,#2f5023); }

.drawer-button-primary { background: var(--modern-bg-tertiary,#fff); color: var(--modern-bg-primary,#2f5023); }

.drawer-button-disabled { background: var(--modern-bg-quaternary,rgba(255,255,255,0.06)) !important; color: var(--modern-text-secondary,rgba(255,255,255,0.6)) !important; cursor: not-allowed !important; }

[dir="rtl"] .modern-panel-radio { margin-right: 0px; margin-left: 12px; }

[dir="rtl"] .modern-panel-input-wrap { margin-left: 0px; margin-right: 12px; }

@media (max-width: 320px) {
  .modern-panel-option { flex-wrap: wrap; }
  .modern-panel-input-wrap { flex-basis: 100%; margin-left: 0px; margin-right: 0px; margin-top: 8px; }
  [dir="rtl"] .modern-panel-input-wrap { margin-left: 0px; margin-right: 0px; margin-top: 8px; }
}

.modern-about-card { box-sizing: border-box; display: flex; align-items: center; gap: 12px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 8px; padding: 16px; margin-bottom: 12px; }

.modern-about-cover { width: 80px; height: 114px; border-radius: 8px; background-image: ; background-attachment: ; background-origin: ; background-clip: ; background-color: ; background-size: contain; background-position: center center; background-repeat: no-repeat; border: 1px solid var(--modern-border-primary,#ececec1a); flex: 0 0 auto; }

.modern-about-card-info { min-width: 0px; display: flex; flex-direction: column; gap: 6px; }

.modern-about-card-desc { font-size: 12px; line-height: 1.5; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); max-height: 100%; overflow: auto; }

.modern-about-list { display: flex; flex-direction: column; gap: 12px; padding: 12px 16px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 8px; }

.modern-about-row { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; border-bottom: .5px solid var(--modern-border-primary,#ececec1a); padding-bottom: 10px; }

.modern-about-row:last-child { border-bottom: 0px; padding-bottom: 0px; }

.modern-about-row-title { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); line-height: 1.6; }

.modern-about-row-content { flex: 1 1 0%; min-width: 0px; font-size: 14px; color: var(--modern-text-primary,#fff); line-height: 1.6; word-break: break-word; font-weight: bold; }

.modern-about-link { color: var(--modern-text-primary,#fff); text-decoration: underline; }

[dir="rtl"] .modern-about-row-title { text-align: right; }

.modern-search-input-wrap { position: relative; display: flex; align-items: center; gap: 12px; height: 40px; padding: 0px 12px 0px 35px; border-radius: 12px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-search-icon { position: absolute; left: 12px; width: 15px; height: 16px; }

.modern-search-icon svg { width: 100%; height: 100%; }

.modern-search-clear-icon { position: absolute; right: 80px; width: 16px; height: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; }

.modern-search-clear-icon svg { width: 100%; height: 100%; }

.modern-search-clear-icon::after { content: ""; position: absolute; right: -12px; top: 50%; transform: translateY(-50%); width: 1px; height: 16px; background: var(--modern-border-primary,#ececec1a); }

.modern-search-input { flex: 1 1 0%; padding: 0px; height: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: transparent; outline: none; color: var(--modern-text-primary,#fff); }

.modern-search-input::placeholder { color: var(--modern-text-secondary,rgba(255,255,255,0.6)); opacity: 1; }

.modern-search-cancel { height: 100%; line-height: 40px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); font-size: 14px; cursor: pointer; }

.modern-search-history { padding: 12px 0px; }

.modern-search-history-header { display: flex; align-items: center; justify-content: space-between; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); font-size: 12px; padding: 4px 2px 8px; }

.modern-search-history-list { display: flex; flex-wrap: wrap; gap: 8px; }

.modern-search-chip { display: inline-flex; align-items: center; height: 28px; padding: 0px 10px; border-radius: 14px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); color: var(--modern-text-primary,#fff); font-size: 12px; cursor: pointer; }

.modern-search-result { min-height: 160px; }

.modern-search-item { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px 8px 8px; border-radius: 6px; margin: 8px 0px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-search-item .left { display: flex; gap: 16px; align-items: center; }

.modern-search-item .thumb { width: 54px; height: 70px; border-radius: 2px; overflow: hidden; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); flex-shrink: 0; position: relative; border: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-search-item .thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }

.modern-search-item .thumb .thumb-bg { position: absolute; inset: 0px; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-search-item .thumb .thumb-bg .thumb-loading-spinner { width: 20px; height: 20px; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-top-color: var(--modern-text-secondary,rgba(255,255,255,0.8)); border-radius: 50%; animation: 0.7s linear 0s infinite normal none running modern-search-thumb-spin; }

.modern-search-item .thumb .thumb-bg.thumb-bg--no-thumb .thumb-loading-spinner { display: none; }

@keyframes modern-search-thumb-spin { 
  100% { transform: rotate(360deg); }
}

.modern-search-item .texts { display: flex; flex-direction: column; gap: 8px; }

.modern-search-item .desc { font-size: 13px; color: var(--modern-text-primary,#fff); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; word-break: break-all; }

.modern-search-item .page { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-search-item .arrow svg { width: 16px; height: 16px; }

.modern-search-empty { padding: 24px 0px 32px; display: flex; flex-direction: column; align-items: center; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-search-empty .icon { position: relative; width: 64px; height: 64px; border-radius: 12px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }

.modern-search-empty .icon::before { content: ""; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--modern-border-primary,#ececec1a); display: block; }

.modern-search-empty .icon::after { content: ""; position: absolute; width: 12px; height: 2px; background: var(--modern-border-primary,#ececec1a); transform: rotate(45deg); right: 18px; bottom: 18px; border-radius: 1px; }

.modern-search-empty .title { font-size: 14px; color: var(--modern-text-primary,#fff); opacity: 0.6; }

.modern-search-empty .desc { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-top: 4px; }

.modern-search-empty { padding: 32px 16px; text-align: center; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-search-empty-desc { font-family: Inter; font-size: 14px; line-height: 21px; letter-spacing: 0px; text-align: center; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-search-empty .mse-hero { position: relative; margin-bottom: 20px; }

.modern-search-empty .mse-badge-svg { position: absolute; right: -4px; bottom: -4px; display: flex; align-items: center; justify-content: center; }

.modern-search-panel { overflow: hidden; display: flex; flex-direction: column; }

.modern-search-panel .modern-tab-search-page { height: 100%; display: flex; flex-direction: column; }

.modern-search-panel .modern-toc-header { padding: 20px 16px 16px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-search-panel .modern-search-form { margin: 0px; }

.modern-search-panel .modern-search-input-wrap { height: 44px; border-radius: 12px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-search-panel .modern-search-input { font-size: 16px; color: var(--modern-text-primary,#fff); }

.modern-search-panel .modern-search-input::placeholder { color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-search-panel .modern-search-result { flex: 1 1 0%; overflow-y: auto; }

.modern-search-panel .modern-search-item { margin-bottom: 8px; border-radius: 8px; transition: 0.2s; }

.modern-search-panel .modern-search-item .thumb { width: 48px; height: 64px; border-radius: 6px; }

.modern-search-panel .modern-search-item .desc { font-size: 14px; color: var(--modern-text-primary,#fff); line-height: 1.4; }

.modern-search-panel .modern-search-item .page { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-search-panel .modern-search-item .arrow { color: var(--modern-border-primary,#ececec1a); }

.modern-search-panel .modern-search-empty { padding: 40px 20px; text-align: center; }

.modern-search-panel .modern-search-empty .icon { width: 64px; height: 64px; margin: 0px auto 16px; color: var(--modern-border-primary,#ececec1a); }

.modern-search-panel .modern-search-empty .title { font-size: 16px; color: var(--modern-text-primary,#fff); font-weight: 500; margin-bottom: 8px; }

.modern-search-panel .modern-search-empty .desc { font-size: 14px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-search-list { overflow-y: auto; }

.modern-search-count { font-size: 14px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-search-loading { padding: 20px; text-align: center; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); font-size: 14px; }

.modern-search-item .desc .highlight { font-weight: 500; background: transparent; }

.modern-secondary-panel-page-search { display: flex; flex-direction: column; overflow: hidden; padding: 0px; }

.modern-secondary-panel-page-search .modern-tab-search-page { box-sizing: border-box; height: 100%; display: flex; flex-direction: column; min-height: 0px; padding: 12px 20px; }

.modern-secondary-panel-page-search .modern-search-result { flex: 1 1 0%; min-height: 0px; overflow-y: auto; }

.modern-secondary-panel-page-search .modern-search-list { overflow: visible; }

.modern-select-text { display: flex; flex-direction: column; height: 100%; padding: 0px 20px; }

.modern-select-text-header { padding-bottom: 8px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); font-size: 17px; font-weight: 600; color: var(--modern-text-primary,#fff); text-align: center; }

.modern-select-text-title { font-size: 17px; font-weight: 600; color: var(--modern-text-primary,#fff); }

.modern-select-text-search-wrapper { padding: 12px 0px; }

.modern-select-text-search-wrapper .modern-search-form { margin: 0px; }

.modern-select-text-search-wrapper .modern-search-input-wrap { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; background-color: var(--modern-bg-quaternary,rgba(255,255,255,0.06)); }

.modern-select-text-content { flex: 1 1 0%; overflow: auto; padding: 16px; margin-bottom: 16px; background-color: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 8px; }

.modern-select-text-textarea { width: 100%; min-height: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; outline: none; font-size: 15px; line-height: 1.5; color: var(--modern-text-primary,#fff); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; overflow-wrap: break-word; white-space: pre-wrap; background-color: transparent; user-select: text; cursor: text; }

.modern-select-text-textarea.loading, .modern-select-text-textarea.empty { color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-select-text-textarea.error { color: rgb(255, 59, 48); }

.modern-select-text-footer { display: flex; padding: 12px 0px; gap: 12px; border-top: .5px solid var(--modern-border-primary,#ececec1a); background: var(--modern-bg-secondary,#2f5023); backdrop-filter: blur(30px); }

.modern-select-text-btn { flex: 1 1 0%; padding: 10px 16px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; background: var(--modern-bg-senary,rgba(0,0,0,0.08)); color: var(--modern-text-primary,#fff); height: 44px; box-sizing: border-box; }

.modern-select-text-btn-copy { background-color: var(--modern-bg-tertiary,#fff); color: var(--modern-accent-primary,#53af32); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; }

.modern-select-text.rtl .modern-search-icon { margin-right: 0px; margin-left: 8px; }

.modern-select-text-textarea mark { background-color: rgb(255, 224, 102); color: var(--modern-text-primary,#fff); }

.modern-text-copy-button { position: fixed; transform: translateX(-50%); z-index: 10000; padding: 12px; background: rgb(16, 16, 16); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer; white-space: nowrap; user-select: none; transition: opacity 0.2s ease-in-out; opacity: 0; }

.modern-text-copy-button.show { opacity: 1; }

.modern-text-copy-button:active { opacity: 0.8; transform: translateX(-50%) scale(0.95); }

.modern-select-text-hint-panel { padding: 20px; }

.modern-select-text-hint-content { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--modern-text-primary,#fff); line-height: 1.5; font-weight: 500; font-family: Inter; }

.modern-share { overflow: auto; padding: 8px 20px 16px; color: rgb(51, 51, 51); }

.modern-share .modern-share-content { background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 12px; }

.modern-share .modern-share-header { display: flex; align-items: flex-start; gap: 16px; padding-bottom: 12px; border-bottom: .5px solid var(--modern-border-primary,#ececec1a); }

.modern-share .modern-share-cover { width: 80px; height: 114px; border-radius: 8px; overflow: hidden; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border: 1px solid var(--modern-border-primary,#ececec1a); box-sizing: border-box; flex: 0 0 auto; }

.modern-share .modern-share-cover img { width: 100%; height: 100%; object-fit: contain; }

.modern-share .modern-share-meta { display: flex; flex-direction: column; justify-content: center; min-width: 0px; gap: 8px; }

.modern-share .modern-share-title { font-size: 16px; line-height: 1.5; font-weight: bold; color: var(--modern-text-primary,#fff); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; white-space: normal; max-height: 3em; }

.modern-share .modern-share-desc { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); line-height: 1.5; }

.modern-share .modern-share-toggle label { display: flex; align-items: center; gap: 12px; font-weight: bold; font-size: 14px; color: var(--modern-text-primary,#fff); }

.modern-share .modern-share-toggle label input { margin: 0px; width: 16px; border-radius: 4px; height: 16px; border: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-share .modern-share-qrcode { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 16px 0px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-share .modern-share-qrcode-tabs { display: flex; gap: 8px; background-color: var(--modern-bg-quinary,rgba(0,0,0,0.06)); padding: 4px; border-radius: 24px; justify-content: center; }

.modern-share .modern-share-qrcode-tabs span { padding: 6px 16px; border-radius: 20px; cursor: pointer; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-share .modern-share-qrcode-tabs .selected { background: rgb(255, 255, 255); color: var(--modern-accent-primary,#53af32); }

.modern-share .modern-share-qrcode-img { background: var(--modern-text-primary,#fff); padding: 10px; width: 140px; height: 140px; border-radius: 12px; box-sizing: border-box; }

.modern-share .modern-share-qrcode-img img { width: 100%; }

.modern-share .modern-share-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }

.modern-share .modern-share-footer { padding: 16px 0px 4px; }

.modern-share .modern-share-item { display: flex; flex-direction: column; align-items: center; gap: 6px; text-decoration: none; color: rgb(51, 51, 51); }

.modern-share button.modern-share-item { border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; background: none; padding: 0px; font: inherit; cursor: pointer; color: inherit; }

.modern-share .modern-share-item .logo { box-sizing: border-box; width: 56px; height: 56px; border-radius: 8px; background: var(--modern-value-color,#fff); display: flex; align-items: center; justify-content: center; }

.modern-share .modern-share-item .logo img { width: 24px; height: 24px; object-fit: contain; }

.modern-share .modern-share-item .title { font-size: 12px; color: var(--modern-text-primary,#fff); }

.modern-share-poster { display: flex; flex-direction: column; height: 100%; background: rgb(255, 255, 255); }

.modern-share-poster-content { flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; overflow: auto; min-height: 0px; }

.modern-share-poster-image { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 100%; min-height: 200px; }

.modern-share-poster-image-loading { position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 16px; color: var(--modern-text-secondary,rgba(0,0,0,0.5)); font-size: 14px; }

.modern-share-poster-spinner { width: 40px; height: 40px; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-top-color: var(--modern-accent,#1890ff); border-radius: 50%; animation: 0.8s linear 0s infinite normal none running modern-share-poster-spin; }

@keyframes modern-share-poster-spin { 
  100% { transform: rotate(360deg); }
}

.modern-share-poster-image img { max-width: 100%; max-height: 100%; width: auto; height: auto; border-radius: 16px; box-shadow: 0 2px 8px var(--modern-border-primary,#ececec1a); }

.modern-share-poster-tip-text { margin-top: 12px; font-size: 14px; color: rgb(38, 38, 38); font-family: Calibri, Helvetica, Inter; font-weight: 500; }

.modern-share-poster-modal-backdrop { position: fixed; inset: 0px; background-color: rgba(0, 0, 0, 0.5); z-index: 9998; display: none; opacity: 0; transition: opacity 0.3s; }

.modern-share-poster-modal-backdrop.show { opacity: 1; }

.modern-share-poster-modal-container { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.9); z-index: 9999; display: none; width: 85%; max-width: 500px; max-height: 90vh; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 16px; box-shadow: 0 8px 32px var(--modern-border-primary,#ececec1a); overflow: hidden; flex-direction: column; transition: transform 0.3s, opacity 0.3s; opacity: 0; }

.modern-share-poster-modal-container.show { transform: translate(-50%, -50%) scale(1); opacity: 1; }

.modern-share-poster-modal-container .modern-share-poster { max-height: 90vh; overflow: hidden; }

.modern-thumbnails-content { padding: 12px 0px; flex: 1 1 0%; min-height: 0px; display: flex; flex-direction: column; }

.modern-thumbs-scroll { width: 100%; flex: 1 1 0%; min-height: 0px; overflow: hidden auto; position: relative; padding: 3px 0px; }

.modern-thumbs-vl-inner { position: relative; width: 100%; box-sizing: border-box; }

.modern-thumbs-vl-inner .modern-thumbs-cell { position: absolute; margin: 0px; }

.modern-thumbs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px; }

.modern-thumbs-cell { background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 2px; overflow: hidden; cursor: pointer; position: relative; backdrop-filter: blur(52px); box-sizing: border-box; border: 2px solid transparent; transition: border-color 0.2s, outline 0.2s; outline: transparent solid 2px; display: flex; flex-direction: column; width: 90px; height: 100px; }

.modern-thumbs-cell.active { border-color: var(--modern-bg-secondary,#2f5023); outline: 2px solid var(--modern-accent-primary,#53af32); }

.modern-thumbs-cell.active .title { color: var(--modern-accent-primary,#53af32); }

.modern-thumbs-cell.clicked { outline: 2px solid var(--modern-accent-primary,#53af32); outline-offset: 0px; }

.modern-thumbs-cell .img { box-sizing: border-box; width: 100%; flex: 1 1 0%; min-height: 0px; position: relative; border-radius: 2px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-thumbs-cell .img img { width: 100%; height: 100%; object-fit: cover; display: none; box-sizing: border-box; }

.modern-thumbs-cell .img.thumb-loading-host { background-repeat: no-repeat; background-position: center center; background-size: 24px 24px; border-radius: 2px; }

.modern-thumbs-cell .img img.loaded { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center center; border-radius: 2px; }

.modern-thumbs-cell .img .bg { width: 100%; height: 100%; display: none; align-items: center; justify-content: center; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-thumbs-cell .img .bg.show { display: flex; }

.modern-thumbs-cell .title { z-index: 2; position: absolute; right: 0px; bottom: 0px; font-size: 14px; color: var(--modern-value-color,#fff); border-radius: 2px 0px 0px; text-align: center; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); box-sizing: border-box; padding: 0px 6px; }

.modern-thumbs-bookmark-icon { position: absolute; top: 0px; right: 4px; width: 12px; height: 20px; z-index: 10; }

.modern-thumbs-bookmark-icon svg { width: 12px; height: 20px; display: block; }

.modern-thumbs-list { width: 100%; height: 100%; }

.modern-tab-thumbs { width: 100%; height: 100%; display: flex; flex-direction: column; }

.modern-thumbnails-panel { display: flex; flex-direction: column; flex: 1 1 0%; }

.modern-thumbnails-header { flex-shrink: 0; padding-bottom: 12px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-secondary-panel-page.modern-secondary-panel-page-thumbnails { padding: 12px; }

.modern-toc-form { backdrop-filter: blur(10px); border: 1px solid var(--modern-border-primary,#ececec1a); border-radius: 12px; box-shadow: 0 8px 32px var(--modern-bg-quinary,rgba(0,0,0,0.12)); overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--modern-bg-tertiary,#fff) !important; }

.modern-toc-form .title { background: linear-gradient(135deg, rgb(102, 126, 234) 0px, rgb(118, 75, 162) 100%); color: var(--modern-text-primary,#fff); padding: 16px 20px; font-weight: 600; font-size: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }

.modern-toc-form .input_search { margin: 16px 20px 8px; padding: 12px 16px; border: 1px solid var(--modern-border-primary,#ececec1a); border-radius: 8px; font-size: 14px; background: var(--modern-bg-quaternary,rgba(255,255,255,0.06)); transition: 0.2s; }

.modern-toc-form .input_search:focus { outline: none; border-color: var(--modern-accent-primary,#53af32); box-shadow: rgba(102, 126, 234, 0.1) 0px 0px 0px 3px; background: var(--modern-bg-tertiary,#fff); }

.modern-toc-form .searchButton { position: absolute; right: 32px; top: 72px; width: 20px; height: 20px; opacity: 0.6; cursor: pointer; transition: opacity 0.2s; }

.modern-toc-form .stage { background: transparent; border-radius: 12px; overflow: hidden; }

.modern-toc-form .swiper { list-style: none; margin: 0px; padding: 12px 8px; max-height: calc(-200px + 100vh); overflow-y: auto; }

@supports (scrollbar-width:thin) {
  .modern-toc-form .swiper { scrollbar-width: thin; scrollbar-color: rgba(0, 0, 0, 0.2) transparent; }
}

.modern-toc-form .swiper::-webkit-scrollbar { width: 6px; }

.modern-toc-form .swiper::-webkit-scrollbar-track { background: transparent; }

.modern-toc-form .swiper::-webkit-scrollbar-thumb { background: rgba(0, 0, 0, 0.2); border-radius: 3px; }

.modern-toc-item { list-style: none; margin: 0px; padding: 0px; transition: 0.2s; }

.modern-toc-content { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; border-radius: 8px; margin: 2px 4px; transition: 0.2s; cursor: pointer; position: relative; overflow: hidden; }

.modern-toc-content::before { content: ""; position: absolute; left: 0px; top: 0px; bottom: 0px; width: 3px; background: linear-gradient(135deg, rgb(102, 126, 234) 0px, rgb(118, 75, 162) 100%); transform: scaleY(0); transition: transform 0.2s; }

.modern-toc-title { flex: 1 1 0%; font-size: 14px; line-height: 1.4; color: rgb(51, 51, 51); font-weight: 400; transition: color 0.2s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.modern-toc-page { font-size: 12px; color: rgba(0, 0, 0, 0.6); margin-left: 8px; font-weight: 500; background: rgba(0, 0, 0, 0.05); padding: 2px 6px; border-radius: 4px; min-width: 20px; text-align: center; }

.modern-toc-arrow { margin-left: 8px; transition: transform 0.2s; color: rgba(0, 0, 0, 0.4); display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 4px; }

.modern-toc-children { padding: 0px; list-style: none; overflow: hidden; transition: max-height 0.3s; background: rgba(0, 0, 0, 0.02); border-radius: 6px; margin: 4px 8px; }

.modern-toc-item.expanded .modern-toc-content { background: rgba(102, 126, 234, 0.12); font-weight: 500; }

.modern-toc-item.expanded .modern-toc-title { color: rgb(102, 126, 234); font-weight: 500; }

.modern-toc-item.expanded .modern-toc-arrow { transform: rotate(90deg); color: rgb(102, 126, 234); }

.modern-toc-form .result { margin: 8px 20px; padding: 8px 12px; background: rgba(102, 126, 234, 0.1); border-radius: 6px; font-size: 12px; color: rgb(102, 126, 234); text-align: center; }

.modern-toc-form .close { background: rgba(255, 255, 255, 0.2); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 6px; padding: 6px; cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; }

@media (max-width: 768px) {
  .modern-toc-form { border-radius: 0px; width: 100% !important; height: 100% !important; top: 0px !important; left: 0px !important; }
  .modern-toc-form .swiper { max-height: calc(-150px + 100vh); }
  .modern-toc-content { padding: 12px 16px; }
  .modern-toc-title { font-size: 15px; }
}

.modern-tab-toc-page { display: flex; flex-direction: column; height: 100%; }

.modern-toc-list { flex: 1 1 0%; overflow: auto; padding-bottom: 8px; max-height: calc(-220px + 100vh); }

.modern-toc-tree { padding-top: 6px; }

.mtoc-root { margin: 0px; padding: 0px; }

.mtoc-item { display: flex; align-items: center; justify-content: space-between; padding: 15px; cursor: pointer; margin-bottom: 2px; border-bottom: .5px solid var(--modern-border-primary,#ececec1a); }

.mtoc-item .left { display: flex; align-items: center; gap: 8px; }

.mtoc-item .toggle { width: 16px; height: 16px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); font-size: 12px; user-select: none; cursor: pointer; }

.mtoc-item .text { font-size: 14px; color: var(--modern-text-primary,#fff); flex: 1 1 0%; white-space: normal; word-break: break-word; overflow-wrap: break-word; }

.mtoc-item .page { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-left: 8px; }

.mtoc-item.mtoc-item-current { color: var(--modern-accent-primary,rgba(83,175,50,0.15)) !important; padding-left: 12px; }

.mtoc-item.mtoc-item-current .text { color: var(--modern-accent-primary,#53af32); font-weight: 600; }

.mtoc-item.mtoc-item-current .page { color: var(--modern-accent-primary,#53af32); font-weight: 600; background-color: rgba(83, 175, 50, 0.1); padding: 2px 6px; border-radius: 4px; }

.mtoc-children { margin: 0px; padding: 0px; }

:root { --modern-bg-primary: #2f5023; --modern-bg-secondary: #2f5023; --modern-bg-tertiary: #fff; --modern-bg-quaternary: rgba(255,255,255,0.06); --modern-bg-quinary: rgba(0,0,0,0.06); --modern-bg-senary: rgba(255,255,255,0.08); --modern-bg-septenary: rgba(255,255,255,0.85); --modern-bg-octonary: rgba(255,255,255,0.2); --modern-bg-nonary: rgba(255,255,255,0.6); --modern-bg-opacity-primary: 1; --modern-bg-opacity-secondary: .94; --modern-text-tertiary: rgba(255,255,255,0.8); --modern-text-secondary: rgba(255,255,255,0.6); --modern-text-quaternary: #262626; --modern-icon-primary: #fff; --modern-icon-tertiary: rgba(255,255,255,0.8); --modern-icon-secondary: rgba(255,255,255,0.6); --modern-border-primary: rgba(236,236,236,0.1); --modern-accent-primary: #53af32; }

html, body { overscroll-behavior-y: none; }

a { color: inherit; text-decoration: none; background: none; outline: none; box-shadow: none; }

.phoneTopBar.modern { touch-action: pan-x pan-y; background: var(--modern-bg-primary,#2f5023); height: 50px; display: flex; align-items: center; justify-content: space-between; padding: 0px 10px; }

.phoneModernBottomBar { touch-action: pan-x pan-y; z-index: 3000; backdrop-filter: blur(30px); border-top: .5px solid var(--modern-border-primary,#ececec1a); box-sizing: border-box; position: absolute; width: 100%; bottom: 0px; left: 0px; background: var(--modern-bg-primary,#2f5023); height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0px 20px; gap: 8px; font-family: Calibri, Helvetica, Inter; }

.phoneTopBar.modern .button { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-family: Calibri, Helvetica, Inter; }

.phoneModernBottomBar .button { height: 43px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-direction: column; flex: 1 0 0%; font-family: Calibri, Helvetica, Inter; }

.phoneModernBottomBar .button.mixButton { justify-content: space-between; }

.phoneModernBottomBar .button img { width: 18px; height: 18px; }

.phoneModernBottomBar .button .svg { width: 18px; height: 18px; }

.phoneModernBottomBar .button span { display: none; font-size: 12px; color: var(--modern-text-primary,#fff); font-family: Calibri, Helvetica, Inter; }

.phoneModernBottomBar .mixButton span { display: inline-block; }

.phoneTopBar.modern .toolbar-title { position: absolute; top: 50%; transform: translateY(-50%); font-size: 16px; color: var(--modern-text-primary,#fff); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; left: 10px; max-width: calc(100% - 110px); font-family: Calibri, Helvetica, Inter; }

.phoneTopBar.modern .toolbar-title.has-logo { left: 10px; max-width: calc(100% - 110px); }

.phoneTopBar.modern a.button.modern-toolbar-logo { min-width: 1px; max-width: none; height: auto; max-height: 100%; display: flex; align-items: center; justify-content: flex-start; box-sizing: border-box; overflow: hidden; width: auto !important; }

.phoneTopBar.modern a.button.modern-toolbar-logo img { max-width: none; object-fit: contain; position: relative !important; top: auto !important; bottom: auto !important; left: auto !important; margin: 0px !important; width: auto !important; }

.phoneTopBar.modern .button .svg, .phoneModernBottomBar .button .svg { width: 20px; height: 20px; }

.phoneTopBar.modern .button .icon, .phoneModernBottomBar .button .icon { display: flex; align-items: center; justify-content: center; }

.phoneModernBottomBar .button.active { background-color: var(--modern-bg-quaternary,rgba(0,0,0,0.06)); }

.drawer-panel { display: flex; flex-direction: column; justify-content: space-between; height: 100%; min-height: 70%; max-height: 100%; backdrop-filter: blur(52px); }

.drawer-panel .drawer-content { display: flex; flex-direction: column; flex: 1 1 0%; min-height: 0px; }

.modern-secondary-panel { box-sizing: border-box; display: flex; flex-direction: column; flex: 1 1 0%; }

.modern-secondary-panel-tabbar-wrap { box-sizing: border-box; padding: 0px 20px; }

.modern-secondary-panel-tabs { box-sizing: border-box; display: flex; align-items: center; justify-content: space-around; height: 40px; border-radius: 8px; position: relative; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); margin-bottom: 8px; }

.modern-secondary-panel-indicator { position: absolute; top: 2px; left: 2px; height: calc(100% - 4px); border-radius: 8px; opacity: 1; transition: transform 0.25s, width 0.25s; z-index: 0; background: var(--modern-bg-septenary,rgba(255,255,255,0.85)); }

.modern-secondary-panel-tab { text-align: center; font-weight: bold; color: var(--modern-text-tertiary,rgba(255,255,255,0.6)); font-size: 14px; padding: 10px 12px; cursor: pointer; z-index: 1; box-sizing: border-box; flex-shrink: 0; }

.modern-secondary-panel-tab.active { color: var(--modern-text-quaternary,#262626); }

.modern-secondary-panel-viewport { position: relative; overflow: hidden; width: 100%; flex: 1 1 0%; border-top: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-secondary-panel-scroller { position: absolute; left: 0px; top: 0px; height: 100%; display: flex; width: 100%; transform: translate3d(0px, 0px, 0px); transition: transform 0.25s; }

.modern-secondary-panel-page { position: relative; box-sizing: border-box; padding: 12px 20px; height: 100%; overflow: auto; }

.modern-phone-list { box-sizing: border-box; padding: 16px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); border-radius: 8px; overflow-y: auto; }

.modern-phone-item { border-bottom: .5px solid var(--modern-border-primary,#ececec1a); padding-bottom: 16px; margin-bottom: 16px; }

.modern-phone-item:last-child { border-bottom: 0px; padding-bottom: 0px; margin-bottom: 0px; }

.modern-phone-item-content { display: flex; align-items: center; justify-content: space-between; }

.modern-phone-item-info { flex: 1 1 0%; min-width: 0px; }

.modern-phone-item-label { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-bottom: 6px; font-weight: 500; }

.modern-phone-item-number { display: flex; gap: 20px; font-size: 12px; color: var(--modern-text-primary,#fff); font-weight: 600; line-height: 1.3; word-break: break-all; }

.modern-phone-item-actions { display: flex; align-items: center; gap: 12px; }

.modern-phone-item-action a:active { text-decoration: none; }

.modern-phone-call-btn { display: flex; align-items: center; gap: 6px; padding: 10px 16px; background: var(--modern-bg-tertiary,#fff); color: var(--modern-bg-primary,#2f5023); border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 600; transition: 0.2s; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; min-width: 70px; justify-content: center; }

.modern-bookmark-panel, .modern-tab-bookmark { display: flex; flex-direction: column; overflow: hidden; }

.modern-bookmark-wrap { display: flex; flex-direction: column; flex: 1 1 0%; min-height: 0px; }

.modern-bookmark-list { flex: 1 1 0%; min-height: 0px; overflow-y: auto; padding-bottom: 8px; }

.modern-bookmark-footer-guide { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; padding: 16px 15px 8px; text-align: center; border-top: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-bookmark-footer-icon { display: flex; align-items: center; justify-content: center; margin-bottom: 8px; }

.modern-bookmark-footer-icon svg { display: block; }

.modern-bookmark-footer-description { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); line-height: 1.5; max-width: 280px; }

.modern-bookmark-wrap .item { display: flex; align-items: center; justify-content: space-between; height: 48px; border-bottom: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-bookmark-wrap .item .thumbnail { width: 44px; height: 44px; border-radius: 6px; object-fit: cover; margin-right: 8px; }

.modern-bookmark-wrap .item .page { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-right: 8px; }

.modern-bookmark-wrap .item .title { font-size: 14px; color: var(--modern-text-primary,#fff); flex: 1 1 0%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.modern-bookmark-wrap .item .delete { width: 18px; height: 18px; cursor: pointer; opacity: 0.7; }

.modern-bookmark-empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 15px; text-align: center; border-radius: 8px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-bookmark-empty-icon { display: flex; align-items: center; justify-content: center; }

.modern-bookmark-empty-icon svg { display: block; }

.modern-bookmark-empty-title { font-size: 14px; font-weight: 600; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-bottom: 8px; line-height: 1.4; }

.modern-bookmark-empty-description { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); line-height: 1.5; max-width: 280px; margin-bottom: 20px; }

.modern-extended-content { box-sizing: border-box; display: flex; flex-direction: column; align-items: center; padding: 0px 20px 16px; width: 100%; transition: 0.3s; flex: 1 1 0%; min-height: 0px; overflow: hidden auto; }

.modern-extended-content.expanded { padding: 20px; }

.modern-extended-button-row { display: grid; justify-content: center; grid-template-columns: repeat(auto-fill, minmax(78px, 1fr)); gap: 32px 10px; width: 100%; overflow: auto; }

.modern-extended-content.expanded .modern-extended-button-row { justify-content: flex-start; gap: 15px; }

.modern-extended-button-row .button { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; cursor: pointer; gap: 5px; }

.modern-extended-content .modern-extended-button-row .button .icon { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-extended-content .modern-extended-button-row .button svg { width: 20px !important; height: 20px !important; }

.modern-extended-button-row .button img { width: 20px; height: 20px; }

.modern-extended-content.expanded .modern-extended-button-row .button img { width: 32px; height: 32px; }

.modern-extended-button-row .button span { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); text-align: center; }

.modern-extended-content.expanded .modern-extended-button-row .button span { font-size: 14px; margin-top: 8px; }

.modern-download-page-info { font-size: 14px; color: var(--modern-text-primary,#fff); }

.modern-download-page-number { font-size: 13px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); margin-left: 8px; font-weight: 500; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); padding: 2px 8px; border-radius: 12px; transition: 0.2s; }

.modern-download-attach { width: 100%; height: 40px; margin-top: 12px; border-radius: 8px; border: 1px solid var(--modern-border-primary,#ececec1a); padding: 0px 10px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); }

.modern-loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 40px; height: 40px; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-top: 4px solid var(--modern-accent-primary,#53af32); border-radius: 50%; animation: 1s linear 0s infinite normal none running spin; }

@keyframes spin { 
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

.modern-bookmark-item { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px 8px 8px; border-radius: 8px; margin: 8px 0px; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); transition: 0.2s; cursor: pointer; }

.modern-bookmark-item .left { display: flex; gap: 16px; align-items: center; flex: 1 1 0%; min-width: 0px; }

.modern-bookmark-thumbnail { width: 54px; height: 70px; border-radius: 6px; overflow: hidden; background: var(--modern-bg-quinary,rgba(0,0,0,0.06)); flex-shrink: 0; position: relative; border: 1px solid var(--modern-border-primary,#ececec1a); }

.modern-bookmark-thumbnail .modern-bookmark-thumb-img { width: 100%; height: 100%; object-fit: contain; display: block; }

.modern-bookmark-icon { position: absolute; top: 0px; right: 4px; width: 10px; height: 16px; z-index: 10; pointer-events: none; }

.modern-bookmark-icon svg { width: 100%; height: 100%; display: block; filter: drop-shadow(rgba(0, 0, 0, 0.3) 0px 1px 2px); }

.modern-bookmark-content { display: flex; flex-direction: column; gap: 8px; flex: 1 1 0%; min-width: 0px; }

.modern-bookmark-title { font-size: 13px; color: var(--modern-text-primary,#fff); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; word-break: break-all; line-height: 1.4; }

.modern-bookmark-page { font-size: 12px; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-bookmark-delete { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 6px; transition: 0.2s; flex-shrink: 0; color: var(--modern-text-secondary,rgba(255,255,255,0.6)); }

.modern-bookmark-delete svg { width: 16px; height: 16px; }

.modern-bookmark-delete svg path { fill: currentcolor; stroke: currentcolor; }

.modern-bookmark-pull-hint { position: absolute; top: 30px; right: 40px; display: flex; align-items: center; gap: 8px; color: rgb(255, 255, 255); font-size: 16px; white-space: nowrap; z-index: 10000; pointer-events: none; transition: opacity 0.3s, top 0.2s; }

.modern-bookmark-pull-hint.hidden { top: -60px; opacity: 0; }

.modern-bookmark-pull-hint.ready { opacity: 1; }

.modern-bookmark-pull-hint.error { opacity: 1; background-color: rgba(244, 67, 54, 0.9); }

.modern-bookmark-pull-icon { top: -30px; right: -24px; position: absolute; display: flex; align-items: center; justify-content: center; width: 12px; height: 50px; color: rgb(255, 255, 255); transition: color 0.3s; }

.modern-bookmark-pull-icon.active { color: rgb(76, 175, 80); }

.modern-bookmark-pull-icon svg { width: 100%; height: 100%; }

.modern-bookmark-pull-arrow { display: flex; align-items: center; justify-content: center; width: 16px; height: 16px; color: rgb(255, 255, 255); transition: transform 0.3s, color 0.3s; }

.modern-bookmark-pull-arrow.rotated { transform: rotate(180deg); }

.modern-bookmark-pull-arrow svg { width: 100%; height: 100%; }

.modern-bookmark-pull-text { font-size: 14px; line-height: 1.4; }

.modern-page-bookmark-indicator { position: absolute; top: 0px; right: 16px; width: 12px; height: 50px; display: flex; align-items: center; justify-content: center; z-index: 1000; pointer-events: none; transition: opacity 0.3s; }

.modern-page-bookmark-indicator.hidden { opacity: 0; pointer-events: none; }

.accessibility-drawer-content { position: absolute; width: 100%; height: 100%; left: 0px; top: 0px; }

.accessibility-drawer-content .access-box { transform: translateX(0px); display: flex; position: relative; width: 100%; height: 100%; left: 0px; top: 0px; gap: 10px; padding: 10px; border-radius: 0px; }

.modern-chatbot-drawer-content { flex: 1 1 0%; display: flex; flex-direction: column; min-height: 0px; height: 100%; width: 100%; box-sizing: border-box; overflow: hidden; }

.modern-chatbot-drawer-content .chatbot-box { flex: 1 1 0%; min-height: 0px; height: 100%; overflow: hidden; display: flex; flex-direction: column; }

.modern-chatbot-drawer-content .chatbot-box .chatbot-frame { flex: 1 1 0%; min-height: 0px; width: 100%; height: 100%; border: 0px; display: block; border-radius: 12px 12px 0px 0px; }

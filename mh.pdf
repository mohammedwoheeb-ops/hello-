.annotation-dashed-underline { position: absolute; pointer-events: auto; cursor: pointer; transition: opacity 0.2s; }

.annotation-dashed-underline:hover { opacity: 0.7; }

.annotation-dashed-underline-container { width: 0px; height: 0px; position: sticky; }

.annotation-dashed-underline-line { position: absolute; pointer-events: auto; cursor: pointer; transition: opacity 0.2s; border-bottom: 2px dashed transparent; }

.annotation-underline-container { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; pointer-events: none; z-index: 3; }

.annotation-note-preview { position: absolute; z-index: 1002; background: rgb(255, 255, 255); border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.15) 0px 4px 16px 0px; border: 1px solid rgb(224, 224, 224); padding: 12px 16px; max-width: 250px; pointer-events: auto; animation: 0.2s ease-in 0s 1 normal none running fadeIn; }

@keyframes fadeIn { 
  0% { opacity: 0; transform: translateY(-4px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.annotation-note-preview-content { font-size: 13px; line-height: 1.5; color: rgb(51, 51, 51); overflow-wrap: break-word; white-space: pre-wrap; max-height: 150px; overflow-y: auto; }

.annotation-note-list-panel, .annotation-note-preview-panel { box-sizing: border-box; position: absolute; z-index: 3003; padding: 20px; background: rgb(255, 255, 255); border-radius: 12px; box-shadow: rgba(29, 31, 33, 0.1) 0px 4px 28px 0px; border: 1px solid rgb(236, 236, 236); display: flex; flex-direction: column; pointer-events: auto; overflow: visible; gap: 12px; font-family: Calibri, Helvetica, Inter; }

.annotation-note-list-header { display: flex; align-items: center; justify-content: space-between; }

.annotation-note-list-header-title { font-size: 14px; font-weight: 700; color: rgb(51, 51, 51); }

.annotation-note-list-header-close { width: 20px; height: 20px; display: none; align-items: center; justify-content: center; cursor: pointer; transition: opacity 0.2s; }

.annotation-note-list-header-close.active { display: flex; }

.annotation-note-list-header-close:hover { opacity: 0.7; }

.annotation-note-list-actions { display: none; align-items: center; justify-content: space-between; padding: 8px; border-radius: 6px; flex-wrap: wrap; background: rgb(249, 249, 250); box-sizing: border-box; }

.annotation-note-list-actions.active { display: flex; }

.annotation-note-list-action-btn { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 6px 12px; font-size: 13px; color: rgb(51, 51, 51); cursor: pointer; border-radius: 6px; transition: background 0.2s; }

.annotation-note-list-action-btn:hover { background: rgb(238, 238, 238); }

.annotation-note-list-action-icon { font-size: 14px; line-height: 1; }

.annotation-note-list-content { overflow-y: auto; max-height: 100%; flex: 1 1 0%; }

.annotation-note-list-item { box-sizing: border-box; padding: 8px 0px; border-bottom: 1px solid rgb(240, 240, 240); position: relative; }

.annotation-note-list-item-text { font-size: 13px; line-height: 1.6; color: rgb(51, 51, 51); overflow-wrap: break-word; white-space: pre-wrap; margin-bottom: 6px; padding-right: 30px; }

.annotation-note-list-item-time { font-size: 11px; color: rgb(153, 153, 153); }

.annotation-note-list-item-more { width: 15px; height: 15px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: rgb(153, 153, 153); font-size: 18px; line-height: 1; transition: color 0.2s; user-select: none; }

.annotation-note-list-item-more:hover { color: rgb(51, 51, 51); }

.annotation-note-list-item-dropdown { box-sizing: border-box; position: absolute; background: rgb(255, 255, 255); border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.15) 0px 0px 4px 0px; display: none; z-index: 1004; min-width: 100px; overflow: hidden; padding: 10px; }

.annotation-note-list-item-dropdown-item { border-radius: 6px; box-sizing: border-box; padding: 10px 14px; text-align: center; font-size: 14px; color: rgb(51, 51, 51); cursor: pointer; transition: background 0.2s; }

.annotation-note-list-item-dropdown-item:hover { background: rgb(238, 238, 238); }

.annotation-note-list-unfold { padding: 12px 20px; text-align: center; font-size: 13px; color: var(--accent-primary,#09f); cursor: pointer; border-top: 1px solid rgb(240, 240, 240); transition: background 0.2s; }


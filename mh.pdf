.annotation-note-hover-panel { position: absolute; background: rgb(255, 255, 255); border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.15) 0px 4px 16px 0px; border: 1px solid rgb(224, 224, 224); display: flex; flex-direction: column; pointer-events: auto; animation: 0.2s ease-in 0s 1 normal none running fadeIn; overflow: hidden; z-index: 1003; }

.annotation-note-hover-actions { padding: 12px 16px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid rgb(224, 224, 224); flex-wrap: wrap; }

.annotation-note-hover-action-btn { display: flex; align-items: center; gap: 6px; padding: 6px 12px; font-size: 13px; color: rgb(51, 51, 51); cursor: pointer; border-radius: 6px; transition: background 0.2s; }

.annotation-note-hover-action-btn:hover { background: rgb(245, 245, 245); }

.annotation-note-hover-notes-list { flex: 1 1 0%; overflow-y: auto; padding: 8px 0px; max-height: calc(-100px + 70vh); }

.annotation-note-hover-item { padding: 12px 16px; border-bottom: 1px solid rgb(240, 240, 240); position: relative; transition: background 0.2s; }

.annotation-note-hover-item:hover { background: rgb(245, 245, 245); }

.annotation-note-hover-item:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.annotation-note-hover-empty { padding: 40px 20px; text-align: center; font-size: 13px; color: rgb(153, 153, 153); }

.annotation-note-item-text-container { position: relative; margin-bottom: 6px; }

.annotation-note-item-text { font-size: 13px; line-height: 1.6; color: rgb(38, 38, 38); font-weight: 500; overflow-wrap: break-word; white-space: pre-wrap; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 7; text-overflow: ellipsis; overflow: hidden; }

.annotation-note-item-expand, .annotation-note-item-collapse { margin-top: 8px; font-size: 12px; color: var(--accent-primary,#09f); cursor: pointer; text-align: left; transition: color 0.2s; }

.annotation-note-item-expand:hover, .annotation-note-item-collapse:hover { opacity: 0.7; }

.annotation-note-item-tool { display: flex; align-items: center; justify-content: space-between; gap: 12px; }

.annotation-note-item-time { font-size: 12px; color: rgb(153, 153, 153); font-weight: 500; }

.annotation-add-text-container { position: absolute; z-index: 10000; box-sizing: border-box; pointer-events: auto; }

.annotation-add-text-content { width: 100%; box-sizing: border-box; outline: none; background: transparent; padding: 4px 8px 4px 16px; line-height: 1.2; border: 2px solid transparent; border-radius: 4px; word-break: break-word; overflow-wrap: break-word; white-space: pre-wrap; cursor: text; caret-color: var(--accent-primary,#09f); user-select: text; }

.annotation-add-text-content:focus { outline: none; }

.annotation-add-text-content { border-color: transparent; }

.annotation-add-text-container:hover .annotation-add-text-content { border-style: dashed; border-color: var(--accent-primary,#09f); }

.annotation-add-text-container.annotation-add-text-selected .annotation-add-text-content { border-style: dashed; border-color: var(--accent-primary,#09f); }

.annotation-add-text-container.annotation-add-text-focused .annotation-add-text-content { border-style: solid; border-color: var(--accent-primary,#09f); }

.annotation-add-text-container:hover .annotation-add-text-drag-handle { opacity: 0.5; }

.annotation-add-text-container.annotation-add-text-selected .annotation-add-text-drag-handle { opacity: 0.5; }

.annotation-add-text-container.annotation-add-text-selected .annotation-add-text-width-handle { display: block; opacity: 1; }

.annotation-add-text-drag-handle { position: absolute; left: 0px; top: 0px; width: 10px; height: 100%; background-color: var(--accent-primary,#09f); cursor: move; pointer-events: auto; z-index: 10002; display: block; opacity: 0; border-radius: 4px; }


.__switch { display: flex; transition: background-color 0.3s; align-items: center; border-radius: 55px; }

.__switchBlock { transition: transform 0.3s; margin: 0px 1px; border-radius: 100%; width: 16px; height: 16px; }

.__switch[data-id="__dhk5i3jf3c8"] { background-color: rgb(233, 233, 234); width: 30px; height: 18px; }


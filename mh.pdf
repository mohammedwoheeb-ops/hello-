.reader_form_phone { z-index: 10001; }

.reader_form_phone .headline { font-size: 24px; color: rgb(51, 51, 51); font-weight: bold; line-height: 1.36em; margin-bottom: 20px; }

.reader_form_phone .classhead { font-size: 16px; color: rgb(153, 153, 153); line-height: 1.88; margin-bottom: 20px; }

.reader_form_phone .subtitle { font-size: 16px; color: rgb(153, 153, 153); line-height: 1.88; margin-bottom: 20px; }

.reader_form_phone .paragraph { font-size: 18px; color: rgb(47, 47, 47); line-height: 1.67; margin-bottom: 25px; text-align: justify; overflow-wrap: break-word; text-indent: 2em !important; background-color: transparent !important; }

.reader_form_phone .paragraphTitle, .paragraphtitle { font-weight: bold; font-size: 18px; color: rgb(47, 47, 47); line-height: 1.67; margin-bottom: 25px; text-align: justify; overflow-wrap: break-word; background-color: transparent !important; }

.reader_form_phone .quote { font-size: 20px; color: rgb(51, 57, 64); line-height: 1.5; text-indent: 2em; margin-bottom: 20px; }


.cover_shadow { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; pointer-events: none; z-index: 1; }

.flip_x { transform: scaleX(-1); }

.flip_y { transform: scaleY(-1); }

.hard_top_border { position: absolute; left: 0px; top: 0px; height: 3px; width: 100%; background-image: -webkit-linear-gradient(top, rgba(240, 240, 200, 0.6), rgba(240, 240, 200, 0)); }

.hard_inner_left_border { position: absolute; z-index: 1; left: 0px; right: auto; top: 0px; width: 10px; height: 100%; background-image: -webkit-linear-gradient(left, rgba(150, 150, 150, 0.4), rgba(180, 180, 180, 0)); }

.hard_left_cover_border { position: absolute; z-index: 0; left: 0px; right: auto; top: 0px; width: 4px; height: 100%; background-image: -webkit-linear-gradient(left, rgba(180, 180, 140, 0.6), rgba(180, 180, 140, 0)); }

.cover_shadow.flip_x .hard_right_border { position: absolute; left: auto; right: 0px; top: 1px; width: 3px; background-image: -webkit-linear-gradient(right, rgba(220, 220, 180, 0.6), rgba(220, 220, 180, 0)); }

.hard_right_border { position: absolute; left: auto; right: 0px; top: 1px; width: 3px; background-image: -webkit-linear-gradient(right, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0)); }

.hard_bottom_border { position: absolute; left: 12px; top: auto; bottom: 0px; height: 3px; background-image: -webkit-linear-gradient(bottom, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0)); }

.cover_shadow.stitch .hard_left_border { position: absolute; left: 0px; top: 0px; width: 0.5%; height: 100%; background-image: -webkit-linear-gradient(left, rgba(60, 60, 40, 0.5), rgba(220, 220, 180, 0)); }


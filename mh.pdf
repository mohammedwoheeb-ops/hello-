.videogallery_form_phone.rightToLeft .item .thumbnail { left: auto; right: 0px; }

.videogallery_form_phone.rightToLeft .progress { left: -5px; right: auto; }

.download_form_phone { font-size: 15px; width: 100%; height: 100%; left: 0px; vertical-align: middle; font-family: Arial, Tahoma; background: transparent; z-index: 1; }

.download_form_phone .stage { margin: 0px; width: 100%; height: 100%; }

.download_form_phone .content { position: relative; }

.download_form_phone .content2 { height: 196px; }

.download_form_phone .pictureList_win10 { margin-left: -75px; left: 50%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; }

.download_form_phone .downloadButton { cursor: pointer; width: auto; font-size: 15px; height: 40px; margin: 10px 20px; background: rgba(255, 255, 255, 0.25); line-height: 40px; vertical-align: middle; text-align: center; }

.download_form_phone .item { cursor: pointer; line-height: 20px; height: 20px; vertical-align: middle; position: relative; margin: 0px 20px; padding: 10px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.2); }

.download_form_phone .item span { margin-left: 12px; vertical-align: middle; }

.download_form_phone .item img { vertical-align: middle; position: absolute; left: 10px; top: 13px; }

.download_form_phone .downloadAttachments input { padding: 0px 5px; width: 102px; height: 30px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; margin-left: 10px; font-size: 12px; }

.download_form_phone .content1 select { margin: 10px; width: 80%; color: rgb(152, 152, 152); height: 30px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 0px; outline: none; }

.download_form_phone .select_content { margin: 0px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.2); text-align: center; }

.download_form_phone.rightToLeft .item img { vertical-align: middle; position: absolute; right: 10px; }

.reader_form_phone .image { max-width: 100%; height: auto; width: auto; margin-left: 50%; transform: translate(-50%, 0px); margin-top: 10px; }


  .annotation-common-header { padding: 16px; }
  .annotation-common-body { padding: 0px 16px; }
  .annotation-common-footer { padding: 16px; }
  .annotation-common-btn { width: 100%; min-width: unset; }
}

@media not all {
  .annotation-common-dialog { max-height: -webkit-fill-available; top: 50%; }
  .annotation-common-body { flex: 1 1 0%; min-height: 0px; }
}


@charset "utf-8";

.access-btn { z-index: 98; position: absolute; left: 18px; top: 60px; cursor: pointer; width: 34px; height: 34px; border-radius: 8px; background: rgb(0, 0, 0); display: flex; justify-content: center; align-items: center; padding: 0px; border: 0px; }

.access-btn > img { width: 26px; height: 26px; }

.access-box { display: none; box-sizing: border-box; z-index: 9998; position: absolute; left: 60px; top: 60px; max-width: 491px; width: calc(100% - 60px); max-height: 100%; height: calc(100% - 110px); background: rgb(0, 0, 0); flex-direction: column; padding: 17px 20px; border-radius: 8px; gap: 20px; overflow: scroll; color: rgb(255, 255, 255); }

.access-box-active { display: flex; }

.access-box-head { display: flex; flex-direction: row; justify-content: space-between; align-items: center; font-size: 20px; font-family: Calibri, Helvetica, Inter; font-weight: 600; color: rgb(255, 255, 255); }

.access-head-text { margin: 0px; font-size: 20px; font-weight: 600; }

.access-close-btn { cursor: pointer; border: 0px; background: none; }

.access-box-content { flex: 1 1 1px; font-size: 16px; font-family: Calibri, Helvetica, Inter; font-weight: 400; color: rgb(255, 255, 255); display: flex; flex-direction: column; gap: 20px; overflow: hidden; }

.access-page-num { margin: 0px; font-size: 20px; font-weight: 600; color: rgb(255, 255, 255); }

.access-text-content { display: flex; flex-direction: column; gap: 20px; overflow: auto; position: relative; font-size: 16px; }

.access-text-content p { user-select: text; white-space: pre-line; overflow-wrap: break-word; }

.access-box-bottom { display: flex; flex-direction: row; justify-content: space-between; align-items: center; gap: 10px; font-size: 12px; font-family: Calibri, Helvetica, Inter; font-weight: 500; color: rgb(0, 0, 0); }

.access-box-btn { display: flex; justify-content: center; align-items: center; box-sizing: border-box; max-width: 112px; width: 100%; height: 41px; border-radius: 6px; background: rgb(255, 255, 255); cursor: pointer; border: 0px; }

.access-main-head { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }

.access-box .access-size-btn-box { display: flex; flex-direction: row; gap: 10px; }

.access-box .access-size-btn { display: flex; justify-content: center; align-items: center; width: 36px; height: 36px; border-radius: 8px; background: rgb(255, 255, 255); cursor: pointer; border: 0px; padding: 0px; }

.access-box .access-btn-inactive { opacity: 0.5; cursor: not-allowed; }

@media not all {
  .access-box { display: flex; position: relative; width: 100%; height: 100%; left: 0px; top: 0px; gap: 10px; padding: 10px; border-radius: 0px; transform: translateX(100%); transition: 0.3s ease-in-out; }
  .access-box-active { transform: translateX(0px); }
  .access-box-content { gap: 10px; }
}

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; white-space: nowrap; clip-path: inset(50%); border: 0px; }

.aria-label-button { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px; margin: 0px; cursor: pointer; appearance: none; }

.print_form .aria-label-title { margin-left: 10px; }

.print_form.rightToLeft .aria-label-title { margin: 0px 30px 0px 0px; }

.settingpc_form .item { box-sizing: border-box; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px; }

.settingpc_form .item .title { display: inline-block; width: 100%; color: rgb(255, 255, 255); font-size: 15px; font-family: Calibri, Helvetica; text-align: center; }

.thumbnail_win10 .aria-label-button { box-sizing: border-box; width: 24px; height: 24px; }

.bookmark_form .item .aria-label-button { position: absolute; cursor: pointer; }

.ad-box-container { position: absolute; z-index: 2000; bottom: 25px; left: 0px; right: 0px; margin: 0px auto; width: 100%; display: none; }

.ad-box-container .ad-box-image { width: 100%; cursor: pointer; float: left; }

.ad-box-container .ad-box-cancel { position: absolute; z-index: 2; right: 0px; top: 0px; cursor: pointer; }

.adsBar { position: absolute; width: 200px; height: 100px; overflow: hidden; }

.google { filter: grayscale(100%); }

.alert-success { min-width: 380px; box-sizing: border-box; border-width: 1px; border-style: solid; border-color: rgb(235, 238, 245); color: rgb(92, 184, 92); position: fixed; left: 50%; top: 60px; transform: translateX(-50%); background-color: rgb(237, 242, 252); text-align: center; border-radius: 4px; padding: 12px 15px; font-size: 16px; transition: 0.25s; opacity: 0; z-index: 999999; }

.alert-success.phone { min-width: 260px; max-width: 100%; }

.alert-success.error { color: rgb(230, 123, 109); background-color: rgb(245, 206, 201); }

.alert-success.show { opacity: 1; transform: translate(-50%, 15px); }

:root { --accent-primary: #09f; --accent-primary-rgb: 0 153 255; }

.noteContainer { box-sizing: border-box; width: 24px; height: 24px; z-index: 1001; font-family: Calibri, Helvetica, Inter; }

.noteContainer .noteBox { z-index: 1; box-sizing: border-box; position: absolute; left: 0px; overflow: hidden; width: 350px; border-radius: 12px; padding: 20px; background: rgb(255, 241, 220); border: 1px solid rgb(236, 236, 236); box-shadow: rgba(29, 31, 33, 0.1) 0px 4px 28px 0px; display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 16px; }

.noteContainer .noteBoxHeader { display: flex; align-items: center; justify-content: space-between; width: 100%; pointer-events: none; }

.noteContainer .noteBoxHeaderRight { display: flex; align-items: center; justify-content: space-between; gap: 15px; }

.noteContainer .noteBoxTitle { font-weight: 700; font-size: 14px; color: rgb(51, 51, 51); }

.noteContainer .noteBoxTime { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 400; font-size: 12px; color: rgb(153, 153, 153); }

.noteContainer .noteBoxTextarea { box-sizing: border-box; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; outline: none; resize: none; width: 100%; min-height: 95px; max-height: 200px; overflow-y: hidden; border-radius: 8px; padding: 16px; background: rgba(255, 255, 255, 0.698); color: rgb(51, 51, 51); font-size: 14px; font-family: Calibri, Helvetica, Inter; }

.noteContainer .note-panel-button { display: flex; cursor: pointer; height: 14px; width: 14px; pointer-events: auto; }

.noteContainer .note-panel-button:hover { opacity: 0.7; background-color: rgb(245, 245, 245); }

.noteContainer .note-panel-button img { height: 14px; width: 14px; pointer-events: none; }

.noteContainer .note-panel-button svg { pointer-events: none; }

.noteContainer .saveNoteButton { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 4px; cursor: pointer; pointer-events: auto; }

.noteContainer .noteBoxFooter { display: flex; align-items: center; justify-content: space-between; width: 100%; pointer-events: none; }

.noteContainer .noteBoxColorItems { display: flex; align-items: center; justify-content: space-between; gap: 14px; }

.noteContainer .noteColorItem { width: 24px; height: 24px; border-radius: 4px; border: 2px solid transparent; cursor: pointer; pointer-events: auto; }

.noteContainer .noteColorItem.active { outline: 2px solid var(--accent-primary,#09f); border: 2px solid rgb(255, 255, 255); }

.noteContainer .noteSvgIcon { width: 100%; height: 100%; cursor: pointer; display: flex; }

.noteContainer .noteSvgIcon svg { pointer-events: none; }

.noteContainer .noteSvgIcon:hover { opacity: 0.7; padding-bottom: 12px; }

.globalNoteBoxOverlay { pointer-events: auto; font-family: Calibri, Helvetica, Inter; }

.globalNoteBoxOverlay .noteBox { z-index: 1; box-sizing: border-box; position: relative; overflow: hidden; width: 350px; border-radius: 12px; padding: 20px; background: rgb(255, 241, 220); border: 1px solid rgb(236, 236, 236); box-shadow: rgba(29, 31, 33, 0.1) 0px 4px 28px 0px; display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 16px; }

.globalNoteBoxOverlay .noteBoxHeader { display: flex; align-items: center; justify-content: space-between; width: 100%; pointer-events: none; }

.globalNoteBoxOverlay .noteBoxHeaderRight { display: flex; align-items: center; justify-content: space-between; gap: 12px; }

.globalNoteBoxOverlay .noteBoxTitle { flex-shrink: 0; font-weight: 700; font-size: 14px; color: rgb(51, 51, 51); }

.globalNoteBoxOverlay .noteBoxTime { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 400; font-size: 12px; color: rgb(153, 153, 153); }

.globalNoteBoxOverlay .noteBoxTextarea { box-sizing: border-box; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; outline: none; resize: none; width: 100%; min-height: 95px; max-height: 200px; overflow-y: auto; border-radius: 8px; padding: 16px; background: rgba(255, 255, 255, 0.698); color: rgb(51, 51, 51); font-size: 14px; font-family: Calibri, Helvetica, Inter; }

.globalNoteBoxOverlay .note-panel-button { display: flex; cursor: pointer; height: 14px; width: 14px; pointer-events: auto; }

.globalNoteBoxOverlay .note-panel-button:hover { opacity: 0.7; background-color: rgb(245, 245, 245); }

.globalNoteBoxOverlay .note-panel-button img { height: 14px; width: 14px; pointer-events: none; }

.globalNoteBoxOverlay .saveNoteButton { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 4px; cursor: pointer; pointer-events: auto; }

.globalNoteBoxOverlay .noteBoxFooter { display: flex; align-items: center; justify-content: space-between; width: 100%; pointer-events: none; }

.globalNoteBoxOverlay .noteBoxColorItems { display: flex; align-items: center; justify-content: space-between; gap: 14px; }

.globalNoteBoxOverlay .noteColorItem { width: 24px; height: 24px; border-radius: 4px; border: 2px solid transparent; cursor: pointer; pointer-events: auto; }

.globalNoteBoxOverlay .noteColorItem.active { outline: 2px solid var(--accent-primary,#09f); border: 2px solid rgb(255, 255, 255); }

.globalNoteBoxOverlay--mobile { right: 0px; bottom: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; left: 0px !important; top: 0px !important; }

.globalNoteBoxOverlay--mobile .noteBox { flex-shrink: 0; max-width: calc(-32px + 100vw); max-height: calc(-32px + 100vh); }

.globalNoteBoxOverlay--mobile .noteBoxTextarea { touch-action: pan-y; overflow-y: auto; }

.globalNoteBoxOverlay--mobile .note-panel-button { box-sizing: border-box; min-width: 40px; min-height: 40px; width: 40px; height: 40px; padding: 10px; display: flex; align-items: center; justify-content: center; }

.globalNoteBoxOverlay--mobile .note-panel-button img { width: 20px; height: 20px; }

.globalNoteBoxOverlay--mobile .saveNoteButton { box-sizing: border-box; min-width: 40px; min-height: 40px; width: 40px; height: 40px; }

.globalNoteBoxOverlay--mobile .noteColorItem { box-sizing: border-box; min-width: 28px; min-height: 28px; width: 28px; height: 28px; }

.annotationPanel { font-family: Calibri, Helvetica, Inter; }

.annotationPanel .note-button { cursor: pointer; position: relative; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 6px; flex-shrink: 0; }

.annotationPanel .note-button:hover { background: rgba(0, 0, 0, 0.06); }

.annotationPanel .noteUndo, .annotationPanel .noteRedo { opacity: 0.5; cursor: default; }

.annotationPanel .note-button.note-button-active { opacity: 1; cursor: pointer; background-color: rgb(var(--accent-primary-rgb) / .06); }

.annotationPanel .note-button img { width: 100%; height: 100%; object-fit: contain; pointer-events: none; }

.annotationPanel .noteDone { cursor: pointer; position: relative; display: flex; align-items: center; justify-content: center; padding: 0px 6px; width: 50px; height: 30px; line-height: 30px; background-color: var(--accent-primary,#09f); border-radius: 6px; font-weight: 500; font-size: 13px; color: rgb(255, 255, 255); }

.annotationPanel .noteDone:hover { opacity: 0.8; }

.annotationPanel > .topBox { border-radius: 6px; position: relative; height: 36px; display: flex; align-items: center; background: rgb(234, 234, 240); border: 1px solid transparent; padding-right: 7px; }

.annotationPanel > .topBox .annoBtnBox { position: relative; display: flex; flex: 1 1 0%; gap: 6px; align-items: center; justify-content: space-between; }

.annotationPanel .noteMoveBar { padding: 0px 10px; height: 100%; cursor: move; display: flex; align-items: center; justify-content: center; }

.annotationPanel .noteMoveBar p { display: inline-block; height: 22px; width: 3px; border-radius: 4px; background: rgb(200, 200, 211); pointer-events: none; }

.annotationPanel > .topBox > .annoBtnBox .anno-split-line { width: 1px; height: 14px; background: rgb(200, 200, 211); }

.annotationPanel.mobile .anno-hide-mobile { display: none !important; }

.annotationPanel .annoCancelBtn { box-sizing: border-box; display: none; width: 100%; height: 38px; align-items: center; justify-content: center; background: rgb(234, 234, 240); cursor: pointer; font-size: 14px; color: rgb(38, 38, 38); font-weight: 700; -webkit-tap-highlight-color: transparent; border-top: 0.5px solid rgb(200, 200, 211); }

.annotationPanel.mobile .annoCancelBtn { display: flex; }

.noteContainer .noteBox.note-preview-mode { cursor: pointer; pointer-events: auto; }

.noteContainer .noteBox.note-preview-mode .noteBoxTextarea { pointer-events: none; user-select: none; }

.noteContainer .noteBox.note-preview-mode .note-panel-close { display: none !important; }

.noteContainer .noteBox.note-edit-mode .noteBoxTextarea { cursor: text; pointer-events: auto; }

@keyframes shake { 
  0% { transform: translateX(0px); }
  100% { transform: translateX(0px); }
  10% { transform: translateX(-5px); }
  30% { transform: translateX(-5px); }
  50% { transform: translateX(-5px); }
  70% { transform: translateX(-5px); }
  90% { transform: translateX(-5px); }
  20% { transform: translateX(5px); }
  40% { transform: translateX(5px); }
  60% { transform: translateX(5px); }
  80% { transform: translateX(5px); }
}

.annotation-shake { animation: 0.5s ease-in-out 0s 1 normal none running shake; }

.noteContainer .noteBox.note-edit-mode { box-shadow: rgba(29, 31, 33, 0.25) 0px 6px 32px 0px; }

.noteContainer .noteBox.note-preview-mode { box-shadow: rgba(29, 31, 33, 0.15) 0px 4px 20px 0px; }

.annotationPanel .bottomBox { display: none; align-items: center; justify-content: flex-start; gap: 20px; box-sizing: border-box; border-radius: 6px; vertical-align: middle; width: 100%; left: 0px; background: rgb(234, 234, 240); position: relative; top: 2px; padding: 0px 12px; height: 40px; }

.annotationPanel .eraserBox { display: none; margin: 6px 0px; }

.annotationPanel .eraserWidth { font-size: 13px; margin-left: 10px; margin-right: 5px; }

.annotationPanel .eraserInput { width: 40px; display: inline-block; padding-left: 3px; height: 20px; line-height: 20px; border: 1px solid rgb(190, 190, 195); border-radius: 2px; }

.annotationPanel .widthBox { display: none; align-items: center; justify-content: space-between; gap: 10px; height: 100%; }

.annotationPanel .setWidth { font-size: 14px; color: rgb(38, 38, 38); }

.annotationPanel .widthSliderContainer { position: relative; display: inline-block; width: 100px; height: 100%; }

.annotationPanel .widthSlider { position: relative; width: 100%; height: 100%; cursor: pointer; }

.annotationPanel .widthSliderBg { position: absolute; top: 50%; width: 100%; height: 10px; border-radius: 10px; transform: translateY(-50%); background: rgb(219, 219, 228); }

.annotationPanel .widthSliderEnter { position: absolute; left: 0px; height: 10px; background: rgb(255, 255, 255); border-radius: 10px; transform: translateY(-50%); top: 50%; transition: width 0.1s; }

.annotationPanel .widthSliderPointer { position: absolute; width: 20px; height: 20px; cursor: pointer; transform: translateY(-50%); top: 50%; transition: left 0.1s; }

.annotationPanel .widthSliderPointer span { border-radius: 50%; background: rgb(255, 255, 255); position: absolute; width: 20px; height: 20px; transition: 0.1s; box-shadow: rgba(44, 47, 53, 0.14) 0px 0px 12px 0px; }

.annotationPanel .widthSliderPointer:hover span { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 4px; }

.customSliderTooltip { display: none; z-index: 10050; box-sizing: border-box; position: absolute; min-width: 29px; height: 32px; padding: 0px 6px; line-height: 32px; background: rgb(0, 0, 0); text-align: center; border-radius: 4px; font-size: 12px; color: rgb(255, 255, 255); pointer-events: none; white-space: nowrap; }

.customSliderTooltip--inline { top: -25px; left: 50%; transform: translateX(-50%); padding: 0px; width: 29px; }

.customSliderTooltip::after { content: ""; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); width: 0px; height: 0px; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 5px solid rgb(0, 0, 0); }

.annotationPanel .alphaBox { display: none; margin: 6px 0px; }

.annotationPanel .setAplha { font-size: 13px; margin-left: 10px; margin-right: 5px; }

.annotationPanel .alphaDisplay { font-size: 13px; margin-left: 5px; color: rgb(102, 102, 102); }

.annotationPanel .inputAlpha { box-sizing: border-box; width: 36px; height: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px; text-align: center; font-size: 14px; color: rgb(38, 38, 38); }

.annotationPanel .colorBox { position: relative; display: none; align-items: center; justify-content: space-between; gap: 10px; height: 100%; font-size: 14px; color: rgb(38, 38, 38); }

.annotationPanel .colorDisplay { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; height: 32px; border-radius: 8px; gap: 10px; background: rgb(255, 255, 255); padding: 6px 10px; }

.annotationPanel .colorSwatch { box-sizing: border-box; display: inline-flex; width: 20px; height: 20px; border-radius: 4px; vertical-align: middle; cursor: pointer; transition: 0.2s; overflow: hidden; border: 1px solid rgb(236, 236, 236); background: transparent !important; }

.annotationPanel .colorSwatchSolid { width: 50%; height: 100%; background: rgb(253, 198, 6); }

.annotationPanel .colorSwatchAlpha { width: 50%; height: 100%; background: rgb(253, 198, 6); }

.annotationPanel .inputColor { box-sizing: border-box; width: 60px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: rgb(38, 38, 38); height: 100%; padding: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; }

.annotationPanel .anno-split-line { height: 100%; border: 1px solid rgb(236, 236, 236); }

@media (max-width: 768px) {
  .annotationPanel > .topBox { overflow: auto hidden; justify-content: flex-start; }
  .annotationPanel > .topBox::-webkit-scrollbar { display: none; }
  .annotationPanel > .topBox .annoBtnBox { flex-wrap: nowrap; flex-shrink: 0; }
  .annotationPanel .noteMoveBar { flex-shrink: 0; }
  .annotationPanel .bottomBox { width: 100%; padding: 6px 8px; flex-wrap: nowrap; overflow-x: auto; min-height: 40px; top: 0px; border-top: 1px solid rgb(200, 200, 211); border-radius: 0px; }
  .annotationPanel .widthSliderContainer { width: 100px; }
  .annotationPanel .setWidth, .annotationPanel .setAplha, .annotationPanel .setColor { font-size: 12px; }
}

.annotationPanel .colorValueSpan { box-sizing: border-box; width: 60px; font-size: 14px; color: rgb(38, 38, 38); vertical-align: middle; cursor: pointer; transition: background-color 0.2s; }

.annotationPanel .colorValueSpan:hover { background-color: rgb(240, 240, 240); }

.annotationPanel .alphaValueSpan { box-sizing: border-box; width: 36px; font-size: 14px; color: rgb(38, 38, 38); vertical-align: middle; cursor: pointer; transition: background-color 0.2s; }

.annotationPanel .alphaValueSpan:hover { background-color: rgb(240, 240, 240); }

.annotationPanel .textFormatBox { gap: 6px; }

.annotationPanel .textFormatButton { cursor: pointer; margin: 0px; padding: 0px; box-sizing: border-box; width: 26px; height: 26px; border-radius: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; gap: 10px; background-color: transparent; }

.annotationPanel .textFormatButton.active { background: rgb(var(--accent-primary-rgb) / .06); color: var(--accent-primary,#09f); }

.textFormatButton.active svg path { fill: var(--accent-primary,#09f); }

.textFormatButton.active svg rect { fill: var(--accent-primary,#09f); }

.annotationPanel .textFormatButton:hover { background: rgba(0, 0, 0, 0.06); }

.annotationPanel .fontSizeDropdown, .annotationPanel .widthDropdown { position: relative; display: inline-block; box-sizing: border-box; }

.annotationPanel .fontSizeDisplay, .annotationPanel .widthDisplay { box-sizing: border-box; position: relative; display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; background: rgb(255, 255, 255); border-radius: 8px; cursor: pointer; user-select: none; transition: border-color 0.2s, box-shadow 0.2s; min-width: 80px; height: 32px; }

.annotationPanel .fontSizeDisplay { gap: 5px; }

.annotationPanel .fontSizeDisplayText { border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; outline: none; }

.annotationPanel .fontSizeDisplayText, .annotationPanel .widthDisplayText { font-size: 14px; color: rgb(38, 38, 38); line-height: 20px; flex: 1 1 0%; text-align: left; width: 30px; }

.annotationPanel .fontSizeDisplayArrow, .annotationPanel .widthDisplayArrow { font-size: 12px; color: rgb(140, 140, 140); margin-left: 8px; transition: transform 0.2s; line-height: 1; display: flex; align-items: center; }

.annotationPanel .fontSizeDropdown.open > .fontSizeDisplay > .fontSizeDisplayArrow, .annotationPanel .widthDropdown.open > .widthDisplay > .widthDisplayArrow { transform: rotate(180deg); }

.annotationPanel .fontSizeOptions, .annotationPanel .widthOptions { position: absolute; top: 100%; left: 0px; margin-top: 4px; width: 95px; max-height: calc(-80px + 100vh); background: rgb(255, 255, 255); border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px; z-index: 1000; display: none; overflow-y: auto; box-sizing: border-box; padding: 5px 10px; }

.annotationPanel .fontSizeDropdown.open-up > .fontSizeOptions, .annotationPanel .widthDropdown.open-up > .widthOptions { top: auto; bottom: 100%; margin-top: 0px; margin-bottom: 4px; }

.annotationPanel .fontSizeDropdown.open > .fontSizeOptions, .annotationPanel .widthDropdown.open > .widthOptions { display: block; }

.annotationPanel .fontSizeOption, .annotationPanel .widthOption { box-sizing: border-box; padding: 8px 12px; font-size: 14px; color: rgb(38, 38, 38); line-height: 20px; border-radius: 6px; cursor: pointer; position: relative; transition: background-color 0.2s; user-select: none; display: flex; align-items: center; justify-content: space-between; }

.annotationPanel .fontSizeOption:hover, .annotationPanel .widthOption:hover { background-color: rgb(238, 238, 238); }

.annotationPanel .fontSizeOptionText, .annotationPanel .widthOptionText { flex: 1 1 0%; text-align: left; }

.annotationPanel .fontSizeOptionCheck, .annotationPanel .widthOptionCheck { display: none; width: 16px; height: 16px; font-size: 14px; color: rgb(38, 38, 38); font-weight: bold; line-height: 16px; text-align: center; flex-shrink: 0; margin-left: 8px; }

.annotation-confirm-mask { position: absolute; inset: 0px; background: transparent; display: none; z-index: 10001; pointer-events: none; }

.annotation-confirm-dialog { position: absolute; background: rgb(255, 255, 255); border-radius: 8px; padding: 12px 16px; min-width: 120px; box-shadow: rgba(0, 0, 0, 0.15) 0px 4px 12px; opacity: 0; transform: scale(0.8); transition: opacity 0.2s, transform 0.2s; pointer-events: auto; }

.annotation-confirm-dialog.annotation-confirm-visible { opacity: 1; transform: scale(1); }

.annotation-confirm-title { text-align: center; font-size: 14px; font-weight: bold; color: rgb(0, 0, 0); margin-bottom: 12px; white-space: nowrap; }

.annotation-confirm-buttons { display: flex; gap: 8px; }

.annotation-confirm-btn { flex: 1 1 0%; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 12px; cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; user-select: none; }

.annotation-confirm-cancel { background: rgb(245, 245, 245); color: rgb(0, 0, 0); transition: background-color 0.2s; }

.annotation-confirm-cancel:hover { background: rgb(240, 240, 240); }

.annotation-confirm-yes { background: var(--accent-primary,#09f); color: rgb(255, 255, 255); transition: background-color 0.2s; }

.annotation-confirm-yes:hover { opacity: 0.85; }

.annotation-button-reddot { position: absolute; top: -2px; right: -2px; width: 8px; height: 8px; background: rgb(245, 74, 69); border-radius: 50%; border: 1px solid rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 2px; z-index: 10; pointer-events: none; }

.annotation-tip-tooltip { position: absolute; background: var(--accent-primary,#09f); border-radius: 6px; padding: 0px; box-shadow: rgba(0, 153, 255, 0.3) 0px 4px 20px; opacity: 0; transform: scale(0.9) translateY(-10px); transition: opacity 0.3s, transform 0.3s; pointer-events: auto; z-index: 10003; max-width: calc(-32px + 100vw); box-sizing: border-box; }

.annotation-tip-tooltip.annotation-tip-visible { opacity: 1; transform: scale(1) translateY(0px); }

.annotation-tip-tooltip::after { content: ""; position: absolute; bottom: -7px; left: var(--tip-arrow-left,50%); transform: translateX(-50%); width: 0px; height: 0px; border-left: 8px solid transparent; border-right: 8px solid transparent; border-top: 8px solid var(--accent-primary,#09f); }

.annotation-tip-content { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding: 12px 16px; box-sizing: border-box; }

.annotation-tip-text { color: rgb(255, 255, 255); font-size: 14px; line-height: 1.5; white-space: normal; overflow-wrap: break-word; word-break: break-word; flex: 1 1 0%; min-width: 0px; }

.annotation-tip-confirm-btn { background: rgb(255, 255, 255); color: var(--accent-primary,#09f); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; padding: 6px 16px; font-size: 14px; font-weight: 500; cursor: pointer; user-select: none; transition: background-color 0.2s; white-space: nowrap; outline: none; }

.annotation-tip-confirm-btn:hover { background: rgb(240, 240, 240); }

.annotation-common-mask { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0); display: none; z-index: 10002; min-height: 100dvh; }

.annotation-common-dialog { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(0.92); width: 420px; max-width: calc(100% - 32px); max-height: -webkit-fill-available; background: rgb(255, 255, 255); border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.06) 0px 0px 20px 10px; opacity: 0; transition: opacity 0.2s, transform 0.2s; display: flex; flex-direction: column; overflow: hidden; }

.annotation-common-dialog.annotation-common-visible { opacity: 1 !important; transform: translate(-50%, -50%) scale(1) !important; }

.annotation-common-header { display: flex; align-items: center; justify-content: space-between; padding: 30px; flex-shrink: 0; }

.annotation-common-title { font-size: 14px; font-weight: 700; color: rgb(51, 51, 51); }

.annotation-common-close { width: 24px; height: 24px; line-height: 24px; text-align: center; border-radius: 4px; cursor: pointer; color: rgb(102, 102, 102); }

.annotation-common-close:hover { background: rgb(243, 243, 243); }

.annotation-common-body { padding: 0px 50px; color: rgb(51, 51, 51); font-size: 12px; overflow-y: auto; overflow-wrap: break-word; word-break: break-word; flex: 1 1 0%; min-height: 0px; }

.annotation-common-footer { display: flex; align-items: center; justify-content: space-between; padding: 30px; flex-shrink: 0; }

.annotation-common-footer.annotation-common-footer--only-buttons { justify-content: flex-end; }

.annotation-common-checkbox { display: inline-flex; align-items: center; gap: 8px; color: rgb(136, 136, 136); user-select: none; font-size: 13px; cursor: pointer; position: relative; }

.annotation-common-checkbox > input[type="checkbox"] { position: absolute; width: 0px; height: 0px; opacity: 0; margin: 0px; padding: 0px; pointer-events: none; }

.annotation-common-checkbox__inner { position: relative; display: inline-block; width: 16px; height: 16px; border: 1px solid rgb(219, 219, 219); border-radius: 4px; background-color: rgb(219, 219, 219); transition: 0.2s; box-sizing: border-box; vertical-align: middle; }

.annotation-common-checkbox__inner::after { content: ""; position: absolute; top: 1px; left: 5px; width: 5px; height: 10px; border-width: 0px 2px 2px 0px; border-style: none solid solid none; border-color: currentcolor rgb(255, 255, 255) rgb(255, 255, 255) currentcolor; border-image: initial; transform: rotate(45deg) scale(0); transition: transform 0.15s ease-in 0.05s; box-sizing: border-box; }

.annotation-common-checkbox__inner.is-checked { background-color: var(--accent-primary,#09f); border-color: var(--accent-primary,#09f); }

.annotation-common-checkbox__inner.is-checked::after { transform: rotate(45deg) scale(1); }

.annotation-common-checkbox:hover .annotation-common-checkbox__inner { border-color: var(--accent-primary,#09f); }

.annotation-common-checkbox__label { color: rgb(136, 136, 136); font-size: 12px; cursor: pointer; line-height: 16px; }

.annotation-common-buttons { display: flex; gap: 8px; }

.annotation-common-btn { box-sizing: border-box; min-width: 88px; height: 36px; padding: 10px 16px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; border: 0px; font-size: 14px; font-weight: 600; }

.annotation-common-primary { background: var(--accent-primary,#09f); color: rgb(255, 255, 255); }

.annotation-common-primary:hover { opacity: 0.8; }

@media (max-width: 768px) {
  .annotation-common-dialog { top: 50%; width: calc(100% - 32px); max-height: -webkit-fill-available; }
  .annotation-common-header { padding: 20px 16px; }
  .annotation-common-title { font-size: 15px; }
  .annotation-common-close { width: 44px; min-width: 44px; height: 44px; min-height: 44px; display: flex; align-items: center; justify-content: center; margin: -10px -10px 0px 0px; }
  .annotation-common-close svg { flex-shrink: 0; }
  .annotation-common-body { padding: 0px 16px; font-size: 13px; line-height: 1.5; }
  .annotation-common-footer { padding: 16px 16px 20px; flex-wrap: wrap; gap: 12px; }
  .annotation-common-footer.annotation-common-footer--only-buttons { justify-content: flex-end; }
  .annotation-common-checkbox { width: 100%; order: 1; gap: 10px; padding: 4px 0px; min-height: 44px; align-items: center; }
  .annotation-common-checkbox__label { font-size: 13px; line-height: 1.4; flex: 1 1 0%; }
  .annotation-common-buttons { order: 2; width: 100%; justify-content: flex-end; }
  .annotation-common-btn { min-height: 44px; min-width: 120px; padding: 12px 24px; font-size: 15px; border-radius: 10px; -webkit-tap-highlight-color: transparent; }
}

@media (max-width: 480px) {
